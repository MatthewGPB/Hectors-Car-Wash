---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import PriceBoard from '../components/PriceBoard.astro';
import OpenStatus from '../components/OpenStatus.astro';
import siteData from '../data/site.json';
import locationsData from '../data/locations.json';
import reviewsData from '../data/reviews.json';
import { generateHomepageSchema } from '../lib/schema';

const shop = locationsData.locations[0];
const title = `Hand Car Wash in North Palm Beach, FL | Hector's Car Wash`;
const description = `Hand car wash on US Highway 1 in North Palm Beach. Washed and dried by hand, inside and out, from $19.99. Detailing and ceramic coating by appointment.`;
const schema = generateHomepageSchema();

const nico = reviewsData.reviews.find((r) => r.id === 'nico');
const featured = reviewsData.reviews.filter((r) => r.homepage && r.id !== 'nico').concat(
  reviewsData.reviews.filter((r) => !r.homepage && r.id === 'peter-flavor')
).slice(0, 3);

const mapQ = encodeURIComponent(`Hector's Car Wash, ${shop.address.street}, ${shop.address.city}, ${shop.address.state} ${shop.address.zip}`);
const mapSrc = `https://www.google.com/maps?q=${mapQ}&output=embed`;
---

<BaseLayout title={title} description={description} schema={schema}>

  {/* ============ HERO ============ */}
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="h-xl">North Palm Beach’s hand car wash.</h1>
        <p class="lede">
          Soap, wash mitts and microfiber towels, a crew of people on every car, and Hector on the lot. Bentleys, work trucks and family SUVs all get the same care.
        </p>
        <OpenStatus class="hero-status" />
        <div class="btn-row stack">
          <a href={shop.mapsUrl} target="_blank" rel="noopener" class="btn btn-azure" data-directions-label={shop.directionsLabel}>Get directions</a>
          <a href="#prices" class="btn btn-line">See prices</a>
        </div>
        <p class="hero-addr">
          <span data-no-i18n>{shop.address.street}, {shop.address.city}</span><br />
          <a href={`tel:${shop.phoneE164}`} data-no-i18n>{shop.phone}</a>
        </p>
      </div>
      <div class="hero-photo">
        <img
          src="/images/story-hector-working.jpg"
          alt="A Hector's crew member hand-drying a white sports car with a microfiber towel"
          width="1200"
          height="1500"
          fetchpriority="high"
        />
      </div>
    </div>
    <hr class="stripe" />
  </section>

  {/* ============ PROOF ============ */}
  <section class="proof section-tight">
    <div class="container-wide proof-grid">
      {nico && (
        <figure class="proof-quote">
          <blockquote data-no-i18n>
            <p>“No where else in Palm Beach County can you get a hand wash as fast and as well as Hector’s. The real treat is all the cars that roll by. Bentleys, Aston Martins, Mercedes galore.”</p>
          </blockquote>
          <figcaption><strong data-no-i18n>{nico.author}</strong>, Google Local Guide</figcaption>
        </figure>
      )}
      <div class="proof-score">
        <div class="score" data-no-i18n>{siteData.brand.rating}</div>
        <p>out of 5 across {siteData.brand.reviewCount}+ Google reviews</p>
        <a href="/pages/review" class="text-link">Read the reviews</a>
      </div>
    </div>
  </section>

  {/* ============ PRICE BOARD ============ */}
  <section class="prices section on-ink" id="prices">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">Five washes. Posted prices.</h2>
        <p class="lede">Hand wash, per car, done while you wait. No membership and no appointment.</p>
      </div>
      <PriceBoard />
      <div class="price-more">
        <a href="/services/car-detailing" class="more">
          <span class="more-name">Full detailing</span>
          <span class="more-price">From $300, by appointment</span>
        </a>
        <a href="/services/ceramic-coating" class="more">
          <span class="more-name">Ceramic coating</span>
          <span class="more-price">From $800, same day</span>
        </a>
      </div>
    </div>
  </section>

  {/* ============ BY HAND ============ */}
  <section class="byhand section">
    <div class="container-wide byhand-grid">
      <div class="byhand-photo">
        <img
          src="/images/location-north-palm-beach.jpg"
          alt="Hector's Car Wash on US Highway 1 in North Palm Beach, a white building with blue lettering"
          width="1600"
          height="800"
          loading="lazy"
        />
      </div>
      <div class="byhand-copy">
        <h2 class="h-lg">What “by hand” means here.</h2>
        <div class="points">
          <div>
            <h3 class="h-sm">Mitts and microfiber, top to bottom.</h3>
            <p>Every car is washed with soft mitts and dried with microfiber towels by trained staff. The right soap for your finish, fresh water, careful hands.</p>
          </div>
          <div>
            <h3 class="h-sm">The inside counts too.</h3>
            <p>From Silver up: vacuum, windows in and out, dash dusted, rims and tires shined. We don't upsell the basics.</p>
          </div>
          <div>
            <h3 class="h-sm">Luxury finishes, handled right.</h3>
            <p>Ceramic-coated paint, chrome, soft-touch interiors. Tell us what your car has and we'll treat it accordingly.</p>
          </div>
          <div>
            <h3 class="h-sm">Walk in. No appointment.</h3>
            <p>Just pull up. Detailing and ceramic coating are booked ahead because they take hours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ BEYOND THE WASH ============ */}
  <section class="beyond section bg-mist">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">When a wash isn’t enough.</h2>
        <p class="lede">Deep cleaning and long-term paint protection, done at the same shop by the same crew.</p>
      </div>
      <div class="beyond-grid">
        <a href="/services/car-detailing" class="svc svc-wide">
          <div class="svc-img">
            <img src="/images/detail-hero.jpg" alt="A crew member polishing a grey Tesla" width="1600" height="800" loading="lazy" />
          </div>
          <div class="svc-body">
            <h3 class="h-md">Full detailing</h3>
            <p>Interior shampoo, clay bar, hand polish, leather conditioning. Four to six hours, from $300.</p>
            <span class="text-link">See what's included</span>
          </div>
        </a>
        <a href="/services/ceramic-coating" class="svc">
          <div class="svc-img">
            <img class="ceramic-img" src="/images/ceramic-water-beading.jpg" alt="Water beading on freshly ceramic-coated paint" width="1200" height="1200" loading="lazy" />
          </div>
          <div class="svc-body">
            <h3 class="h-md">Ceramic coating</h3>
            <p>One package, priced by vehicle size. Drop off at 8 AM, drive home the same day. From $800.</p>
            <span class="text-link">How it works</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ============ HECTOR ============ */}
  <section class="hector section">
    <div class="container-wide hector-grid">
      <div class="hector-photo">
        <img src="/images/about-hector-portrait.jpg" alt="Hector David Ramirez, owner of Hector's Car Wash" width="1600" height="2000" loading="lazy" />
      </div>
      <div class="hector-copy">
        <h2 class="h-lg">The name on the sign is the man on the lot.</h2>
        <div class="prose">
          <p>Hector started at a local car wash almost thirty years ago and worked his way up to running the place. He learned the soaps, the towels, the drying, and the difference between a car that looks clean and one that is.</p>
          <p>In 2019 he opened his own shop on US Highway 1 with one rule: every car gets the care he'd give his own.</p>
        </div>
        <a href="/about" class="text-link">Read Hector's story</a>
      </div>
    </div>
  </section>

  {/* ============ REVIEWS ============ */}
  <section class="reviews section bg-mist">
    <div class="container-wide">
      <div class="reviews-head">
        <h2 class="h-lg">What regulars say.</h2>
        <a href="/pages/review" class="text-link">All reviews, or leave one</a>
      </div>
      <div class="reviews-grid">
        {featured.map((r) => (
          <ReviewCard quote={r.shortQuote} author={r.author} source={r.source} />
        ))}
      </div>
    </div>
  </section>

  {/* ============ VISIT ============ */}
  <section class="visit section" id="visit">
    <div class="container-wide visit-grid">
      <div class="visit-copy">
        <h2 class="h-lg">Find us on US-1.</h2>
        <OpenStatus class="visit-status" />
        <dl class="visit-facts">
          <div>
            <dt>Address</dt>
            <dd data-no-i18n>{shop.address.street}<br />{shop.address.city}, {shop.address.state} {shop.address.zip}</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${shop.phoneE164}`} data-no-i18n>{shop.phone}</a></dd>
          </div>
          <div>
            <dt>Monday to Saturday</dt>
            <dd data-no-i18n>{shop.hours.monSat}</dd>
          </div>
          <div>
            <dt>Sunday</dt>
            <dd data-no-i18n>{shop.hours.sunday}</dd>
          </div>
        </dl>
        <p class="visit-area">{shop.neighborhoodsCopy}</p>
        <div class="btn-row stack">
          <a href={shop.mapsUrl} target="_blank" rel="noopener" class="btn btn-ink" data-directions-label={shop.directionsLabel}>Get directions</a>
          <a href={`tel:${shop.phoneE164}`} class="btn btn-line">Call the shop</a>
        </div>
      </div>
      <div class="visit-map">
        <iframe
          src={mapSrc}
          title="Map to Hector's Car Wash in North Palm Beach"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ============ HERO ============ */
  .hero { position: relative; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    min-height: min(calc(100vh - 76px), 860px);
  }
  .hero-copy {
    align-self: center;
    padding: 72px 56px 72px max(32px, calc((100vw - 1240px) / 2 + 32px));
  }
  .hero-copy h1 { font-size: clamp(40px, 5.2vw, 78px); max-width: 8.6em; }
  .hero-copy .lede { margin-top: 28px; max-width: 31em; }
  .hero-copy :global(.hero-status) { margin: 32px 0 20px; }
  .hero-addr { margin: 24px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-slate); }
  .hero-addr a { color: var(--color-ink); font-weight: 700; text-decoration: none; }

  .hero-photo { position: relative; overflow: hidden; background: var(--color-mist); }
  .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 40%;
  }
  /* The one orchestrated moment: a squeegee pass across the photo on load */
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo img { animation: wipe 1.1s cubic-bezier(0.65, 0, 0.25, 1) 0.15s both; }
    .hero-photo::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 12px;
      background: var(--color-azure);
      animation: blade 1.1s cubic-bezier(0.65, 0, 0.25, 1) 0.15s both;
    }
  }
  @keyframes wipe {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes blade {
    0% { left: 0; opacity: 1; }
    92% { left: calc(100% - 12px); opacity: 1; }
    100% { left: calc(100% - 12px); opacity: 0; }
  }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; min-height: 0; }
    .hero-copy { padding: 48px 20px 44px; }
    .hero-photo { order: -1; aspect-ratio: 4 / 3; }
  }

  /* ============ PROOF ============ */
  .proof-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .proof-quote { margin: 0; }
  .proof-quote blockquote { margin: 0 0 16px; }
  .proof-quote p {
    margin: 0;
    font-stretch: 108%;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .proof-quote figcaption { font-size: 15px; color: var(--color-slate); }
  .proof-quote strong { color: var(--color-ink); }
  .proof-score { border-left: 2px solid var(--color-ink); padding-left: 36px; }
  .score {
    font-stretch: 125%;
    font-weight: 850;
    font-size: clamp(72px, 8vw, 112px);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--color-azure);
  }
  .proof-score p { margin: 14px 0 14px; font-size: 16px; color: var(--color-slate); max-width: 14em; }
  @media (max-width: 860px) {
    .proof-grid { grid-template-columns: 1fr; gap: 36px; }
    .proof-score { border-left: 0; border-top: 2px solid var(--color-ink); padding: 28px 0 0; }
  }

  /* ============ PRICES ============ */
  .price-more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
  }
  .more {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: 22px 26px;
    border: 1.5px solid rgba(255,255,255,0.25);
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .more:hover { border-color: var(--color-azure); background: rgba(46,156,214,0.12); }
  .more-name { font-stretch: 118%; font-weight: 750; font-size: 19px; }
  .more-price { color: var(--color-azure-light); font-size: 15px; }
  @media (max-width: 760px) {
    .price-more { grid-template-columns: 1fr; }
    .more { border-radius: 20px; }
  }

  /* ============ BY HAND ============ */
  .byhand-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 72px;
    align-items: start;
  }
  .byhand-photo { position: sticky; top: 108px; }
  .byhand-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 38% 50%; }
  .byhand-copy h2 { margin-bottom: 44px; }
  .points { display: grid; gap: 0; border-top: 2px solid var(--color-ink); }
  .points > div { padding: 26px 0; border-bottom: 1px solid var(--color-line); }
  .points p { margin: 10px 0 0; font-size: 16.5px; line-height: 1.6; color: var(--color-slate); max-width: 34em; }
  @media (max-width: 960px) {
    .byhand-grid { grid-template-columns: 1fr; gap: 40px; }
    .byhand-photo { position: static; }
    .byhand-photo img { aspect-ratio: 16 / 10; }
  }

  /* ============ BEYOND ============ */
  .beyond-grid { display: grid; grid-template-columns: 1.45fr 1fr; gap: 28px; align-items: stretch; }
  .svc {
    display: flex;
    flex-direction: column;
    background: #fff;
    color: var(--color-ink);
    text-decoration: none;
  }
  .svc-img { overflow: hidden; aspect-ratio: 4 / 3; }
  .svc-wide .svc-img { aspect-ratio: auto; flex: 1; min-height: 300px; }
  .svc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .svc:hover .svc-img img { transform: scale(1.03); }
  .svc-img .ceramic-img { object-position: 50% 100%; }
  .svc-body { padding: 28px 30px 32px; }
  .svc-body p { margin: 12px 0 18px; font-size: 16.5px; line-height: 1.55; color: var(--color-slate); max-width: 32em; }
  @media (max-width: 860px) {
    .beyond-grid { grid-template-columns: 1fr; }
    .svc-wide .svc-img { aspect-ratio: 16 / 10; flex: none; min-height: 0; }
  }

  /* ============ HECTOR ============ */
  .hector-grid { display: grid; grid-template-columns: 0.8fr 1fr; gap: 80px; align-items: center; }
  .hector-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .hector-copy h2 { margin-bottom: 32px; max-width: 11em; }
  .hector-copy .prose { margin-bottom: 26px; }
  @media (max-width: 900px) {
    .hector-grid { grid-template-columns: 1fr; gap: 40px; }
    .hector-photo { max-width: 420px; }
  }

  /* ============ REVIEWS ============ */
  .reviews-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 48px;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .reviews-grid > :global(*) { border-top: 2px solid var(--color-ink); padding-top: 26px; }
  @media (max-width: 960px) { .reviews-grid { grid-template-columns: 1fr; gap: 40px; } }

  /* ============ VISIT ============ */
  .visit-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 64px; align-items: stretch; }
  .visit-copy :global(.visit-status) { margin: 24px 0 8px; }
  .visit-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 32px;
    margin: 28px 0;
    padding: 28px 0;
    border-top: 2px solid var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .visit-facts dt { font-size: 14px; font-weight: 650; color: var(--color-azure-deep); margin-bottom: 4px; }
  .visit-facts dd { margin: 0; font-size: 17px; line-height: 1.5; }
  .visit-facts a { color: var(--color-ink); font-weight: 700; text-decoration: none; }
  .visit-area { margin: 0 0 28px; font-size: 16px; line-height: 1.6; color: var(--color-slate); max-width: 34em; }
  .visit-map { min-height: 460px; background: var(--color-mist); }
  .visit-map iframe { width: 100%; height: 100%; min-height: 460px; border: 0; display: block; }
  @media (max-width: 960px) {
    .visit-grid { grid-template-columns: 1fr; gap: 40px; }
    .visit-map, .visit-map iframe { min-height: 340px; }
  }
  @media (max-width: 480px) { .visit-facts { grid-template-columns: 1fr; } }
</style>
