---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import reviewsData from '../data/reviews.json';
import siteData from '../data/site.json';

const title = `Reviews | ${siteData.brand.name}`;
const description = `Real Google reviews from Hector's Car Wash customers across North Palm Beach, Jupiter, and Riviera Beach. ${siteData.brand.rating} stars, ${siteData.brand.reviewCount}+ reviews.`;

const allReviews = reviewsData.reviews;
const featuredReview = allReviews.find((r) => r.id === 'nico');
const otherReviews = allReviews.filter((r) => r.id !== 'nico');
---

<BaseLayout title={title} description={description}>

  <PageHero
    eyebrow={`${siteData.brand.rating} stars · ${siteData.brand.reviewCount}+ Google reviews`}
    headlineHtml="What Palm Beach<br /><em>says about us.</em>"
    lead="Real Google reviews from customers across North Palm Beach, Jupiter, and Riviera Beach. The kind you can't fake."
    metaLeft="Updated regularly"
    metaRight="Verified on Google"
  />

  {/* ============ FEATURED REVIEW — LARGE PULL QUOTE ============ */}
  {featuredReview && (
    <section class="featured-review section-pad">
      <div class="container-narrow">
        <div class="rule-ornament">
          <div class="rule-ornament-diamond"></div>
        </div>
        <blockquote class="pull-quote">
          "{featuredReview.quote}"
          <span class="pull-quote-attribution">
            — {featuredReview.author} · {featuredReview.source}
          </span>
        </blockquote>
      </div>
    </section>
  )}

  {/* ============ REMAINING REVIEWS — EDITORIAL GRID ============ */}
  <section class="reviews-grid-section section-pad">
    <div class="container-wide">
      <div class="section-intro">
        <div class="eyebrow centered">More from regulars</div>
        <h2 class="display-2">
          What customers<br />
          <em>keep coming back to say.</em>
        </h2>
      </div>

      <div class="reviews-grid">
        {otherReviews.map((review) => (
          <ReviewCard
            quote={review.quote}
            author={review.author}
            source={review.source}
            variant="large"
          />
        ))}
      </div>

      <div class="reviews-stats">
        <div class="stat">
          <div class="stat-num">{siteData.brand.rating}</div>
          <div class="stat-stars">★★★★★</div>
          <div class="stat-label">Average rating</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <div class="stat-num">{siteData.brand.reviewCount}+</div>
          <div class="stat-label">Google reviews</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <div class="stat-num">~30</div>
          <div class="stat-label">Years in business</div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ CTA TO LEAVE A REVIEW ============ */}
  <section class="leave-review section-pad-sm">
    <div class="container-narrow">
      <div class="rule-ornament">
        <div class="rule-ornament-diamond"></div>
      </div>
      <div class="leave-review-content">
        <div class="eyebrow centered">If you're a regular</div>
        <h2 class="display-3">
          Your review helps<br />
          <em>another customer find us.</em>
        </h2>
        <p>
          We don't pay for reviews, run promotions for them, or pressure customers to leave them. But if you've had a good experience and want to leave one, the Google link is right here.
        </p>
        <a href={siteData.primary.googleReviewsUrl} target="_blank" rel="noopener" class="btn btn-primary">
          Leave a Google review →
        </a>
      </div>
    </div>
  </section>

  {/* ============ FINAL CTA ============ */}
  <section class="final-cta">
    <div class="container-narrow">
      <h2 class="display-2 inverse">
        See for yourself.<br />
        <em>Walk in today.</em>
      </h2>
      <p class="final-lead">
        Three Palm Beach County locations. Open Monday through Saturday 8:00–5:30 and Sunday 9:00–4:00.
      </p>
      <div class="final-actions">
        <a href="/#locations" class="btn btn-primary on-dark">Find a location</a>
        <a href={siteData.primary.calendly} class="btn-ghost on-dark">Book detailing →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .featured-review {
    background: var(--color-cream);
  }
  .featured-review .rule-ornament {
    margin-bottom: 48px;
  }

  .reviews-grid-section {
    background: var(--color-cream-warm);
  }
  .section-intro {
    text-align: center;
    margin-bottom: 72px;
  }
  .section-intro .eyebrow { margin-bottom: 24px; }
  .section-intro h2 { margin: 0; }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .reviews-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 64px;
    margin-top: 96px;
    padding: 56px 0;
    border-top: 1px solid var(--color-gray-line);
    border-bottom: 1px solid var(--color-gray-line);
  }
  .stat {
    text-align: center;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 500;
    color: var(--color-navy);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-stars {
    color: var(--color-gold);
    font-size: 16px;
    letter-spacing: 0.12em;
    margin: 8px 0;
  }
  .stat-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gray-warm);
    margin-top: 8px;
  }
  .stat-divider {
    width: 1px;
    height: 80px;
    background: var(--color-gold);
    opacity: 0.3;
  }

  .leave-review {
    background: var(--color-cream);
    text-align: center;
  }
  .leave-review .rule-ornament {
    margin-bottom: 56px;
  }
  .leave-review-content .eyebrow {
    margin-bottom: 24px;
  }
  .leave-review-content h2 {
    margin: 0 0 32px;
  }
  .leave-review-content p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.5;
    color: var(--color-charcoal-soft);
    max-width: 580px;
    margin: 0 auto 40px;
  }

  /* ============ FINAL CTA ============ */
  .final-cta {
    padding: 128px 0;
    background: var(--color-navy-deep);
    color: var(--color-cream);
    text-align: center;
    position: relative;
  }
  .final-cta::before,
  .final-cta::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-gold);
    opacity: 0.3;
  }
  .final-cta::before { top: 32px; }
  .final-cta::after { bottom: 32px; }
  .display-2.inverse { color: var(--color-cream); }
  .display-2.inverse em { color: var(--color-gold); }
  .final-lead {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.5;
    color: rgba(247, 242, 232, 0.8);
    max-width: 540px;
    margin: 32px auto 48px;
  }
  .final-actions {
    display: flex;
    gap: 32px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn-ghost.on-dark {
    color: var(--color-gold);
    border-bottom-color: var(--color-gold);
  }
  .btn-ghost.on-dark:hover {
    color: var(--color-gold-light);
    border-bottom-color: var(--color-gold-light);
  }
  .btn.on-dark { background: var(--color-gold); color: var(--color-navy); }
  .btn.on-dark:hover { background: var(--color-gold-light); }

  @media (max-width: 1024px) {
    .reviews-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .reviews-stats { flex-direction: column; gap: 40px; }
    .stat-divider { width: 80px; height: 1px; }
  }
  @media (max-width: 640px) {
    .final-cta { padding: 80px 0; }
  }
</style>
