---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import EndCTA from '../../components/EndCTA.astro';
import reviewsData from '../../data/reviews.json';
import locationsData from '../../data/locations.json';
import siteData from '../../data/site.json';

const shop = locationsData.locations[0];
const title = `Reviews | ${siteData.brand.name}, North Palm Beach`;
const description = `Read what customers say about Hector's hand car wash in North Palm Beach, or leave your own Google review. ${siteData.brand.rating} stars across ${siteData.brand.reviewCount}+ reviews.`;
const nico = reviewsData.reviews.find((r) => r.id === 'nico');
const others = reviewsData.reviews.filter((r) => r.id !== 'nico');
---

<BaseLayout title={title} description={description}>

  <PageHero
    title="What North Palm Beach says."
    lead="Real Google reviews from people who bring their cars to US-1. If you've been, leaving one takes a minute and helps the next driver find us."
  >
    <div class="score-row">
      <span class="score" data-no-i18n>{siteData.brand.rating}</span>
      <span class="score-note">out of 5 across {siteData.brand.reviewCount}+ Google reviews</span>
      <a href={shop.reviewUrl} target="_blank" rel="noopener" class="btn btn-azure">Leave a Google review</a>
    </div>
  </PageHero>

  {nico && (
    <section class="section-tight bg-mist">
      <div class="container-narrow">
        <ReviewCard quote={nico.quote} author={nico.author} source={nico.source} variant="large" />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-wide rgrid">
      {others.map((r) => (
        <ReviewCard quote={r.quote} author={r.author} source={r.source} />
      ))}
    </div>
  </section>

  <EndCTA title="See for yourself." />

</BaseLayout>

<style>
  .score-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 40px; }
  .score { font-stretch: 125%; font-weight: 850; font-size: 72px; letter-spacing: -0.05em; line-height: 0.9; color: var(--color-azure); }
  .score-note { font-size: 16px; color: var(--color-slate); max-width: 13em; }
  .rgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px 64px; }
  .rgrid > :global(*) { border-top: 2px solid var(--color-ink); padding-top: 26px; }
  @media (max-width: 800px) { .rgrid { grid-template-columns: 1fr; gap: 40px; } }
</style>
