---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';

const title = "Page not found | Hector's Car Wash";
const description = "The page you're looking for doesn't exist. Find our locations and services here.";
---

<BaseLayout title={title} description={description}>
  <Nav />
  <section class="not-found">
    <div class="h-container">
      <div class="content">
        <p class="num">404</p>
        <h1 class="h-display">Page not found.</h1>
        <p class="lead">
          The page you're looking for doesn't exist — but we're still here, hand-washing cars seven days a week.
        </p>
        <div class="actions">
          <a href="/" class="h-btn h-btn-primary">Back to home</a>
          <a href="/#locations" class="h-btn h-btn-outline">Find a location</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 120px 0;
    text-align: center;
    background: var(--color-cream);
    min-height: 60vh;
  }
  .num {
    font-family: var(--font-display);
    font-size: 80px;
    font-style: italic;
    color: var(--color-gold);
    font-weight: 400;
    margin: 0;
    line-height: 1;
  }
  .not-found h1 {
    font-size: clamp(36px, 5vw, 56px);
    margin: 16px 0 24px;
  }
  .lead {
    font-size: 17px;
    color: var(--color-charcoal-soft);
    max-width: 520px;
    margin: 0 auto 40px;
  }
  .actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
