---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Page not found | Hector's Car Wash";
const description = "That page doesn't exist. Find prices, hours and directions for Hector's hand car wash in North Palm Beach.";
---

<BaseLayout title={title} description={description} showAnnouncement={false}>
  <section class="nf section">
    <div class="container-wide">
      <p class="code" data-no-i18n>404</p>
      <h1 class="h-xl">Wrong turn off US-1.</h1>
      <p class="lede">That page doesn't exist. The car wash does, and it's open seven days a week.</p>
      <div class="btn-row">
        <a href="/" class="btn btn-azure">Back to home</a>
        <a href="/#prices" class="btn btn-line">See prices</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { min-height: 62vh; display: flex; align-items: center; }
  .code { font-stretch: 125%; font-weight: 850; font-size: 20px; color: var(--color-azure-deep); margin: 0 0 16px; }
  .lede { margin: 24px 0 36px; }
</style>
