---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Page not found | Hector's Car Wash";
const description = "The page you're looking for doesn't exist. Find our locations and services here.";
---

<BaseLayout title={title} description={description} showAnnouncement={false}>
  <section class="not-found section-pad">
    <div class="container-narrow">
      <div class="not-found-content">
        <p class="num">404</p>
        <h1 class="display-2">
          Page not<br />
          <em>found.</em>
        </h1>
        <p class="lead">
          The page you're looking for doesn't exist — but we're still here, hand-washing cars seven days a week.
        </p>
        <div class="actions">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/#locations" class="btn btn-outline">Find a location</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    background: var(--color-cream);
    text-align: center;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .not-found-content {
    width: 100%;
  }
  .num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 96px;
    color: var(--color-gold);
    font-weight: 400;
    margin: 0;
    line-height: 1;
  }
  .not-found h1 {
    margin: 16px 0 32px;
  }
  .lead {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 2vw, 22px);
    color: var(--color-charcoal-soft);
    max-width: 520px;
    margin: 0 auto 40px;
    line-height: 1.5;
  }
  .actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
