---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CalendlyInline from '../../components/CalendlyInline.astro';
import FAQ from '../../components/FAQ.astro';
import EndCTA from '../../components/EndCTA.astro';
import locationsData from '../../data/locations.json';
import siteData from '../../data/site.json';
import { generateServiceSchema } from '../../lib/schema';

const shop = locationsData.locations[0];

const faqs = [
  {
    question: "What is ceramic coating?",
    answer: "Ceramic coating is a liquid polymer that bonds chemically with your car's clear coat to create a hard, transparent, hydrophobic layer of protection. Once cured, it forms a semi-permanent shield that lasts for years depending on the product and care. It's the strongest paint protection available short of paint protection film (PPF).",
  },
  {
    question: "How much does ceramic coating cost in Palm Beach County?",
    answer: "Hector's offers one professional ceramic coating package for every car — the same coating, the same process, whether it's a compact or a full-size SUV. Pricing starts at $800 for smaller vehicles and goes up with the size and value of the car, because a larger vehicle takes more product and more time. We give every quote on-site, after we've seen the car. Bring it by or send photos through Calendly and we'll give you an exact number.",
  },
  {
    question: "How long does ceramic coating take?",
    answer: "One day. Drop the car off at 8 AM and it's ready the same day. We wash, decontaminate, prep, correct the paint if it's needed, apply the coating, and let it set — all in a single day when you bring it in first thing. You'll get the exact pickup time when you book.",
  },
  {
    question: "Is ceramic coating worth it in Florida?",
    answer: "For most Palm Beach County drivers, yes — possibly more than anywhere else in the country. Florida's combination of intense UV, salt air, humidity, and frequent rain is brutal on paint. Ceramic coating's UV protection alone can extend the life of your clear coat by years. The hydrophobic effect makes the car much easier to wash. Bird droppings and tree sap, which can etch unprotected paint in hours, slide off coated paint with a rinse. For luxury vehicles, leases, and any car you plan to keep more than two years, ceramic coating is among the best dollar-per-year protection investments available.",
  },
  {
    question: "What's the difference between ceramic coating and a ceramic spray?",
    answer: "Very different products. A ceramic spray, whether it comes as a wash add-on or out of a bottle, lays down a thin water-repelling layer that lasts a few weeks. A professional ceramic coating is a polymer that bonds to the clear coat and lasts for years. The spray is a nice short-term shine. The coating is a real paint protection system, applied by hand after the paint is prepped.",
  },
  {
    question: "Will ceramic coating prevent scratches?",
    answer: "It will prevent some scratches but not all. Ceramic coating is harder than your clear coat (around 9H on the pencil hardness scale), which means it resists swirl marks from improper washing and fine scratches from light contact. It will not prevent deep scratches from keys, shopping carts, or rocks. For full scratch prevention, paint protection film (PPF) is the better choice — and PPF and ceramic can be used together for maximum protection.",
  },
  {
    question: "How do I wash a ceramic-coated car?",
    answer: "Wash regularly — every 1 to 2 weeks for daily drivers. Use a pH-neutral soap. A hand wash like the one at Hector's is ideal. Avoid harsh cleaners and abrasive sponges. We give every ceramic customer a care guide at delivery and recommended products to maintain the coating.",
  },
  {
    question: "How long does ceramic coating last?",
    answer: "A professional ceramic coating lasts for years — far longer than wax or the express ceramic spray — depending on the environment and how the car is maintained. Hector's uses coatings from established manufacturers. Warranty details are confirmed on-site when we give you the quote, so you know exactly what's covered before any work starts.",
  },
  {
    question: "Do I need paint correction before ceramic coating?",
    answer: "Often, yes. Ceramic coating is transparent — it locks in whatever's underneath. If your paint has swirl marks, light scratches, water spots, or oxidation, the coating will preserve them for years. Paint correction is a polishing process that removes these defects before the coating goes on. We inspect every car and recommend correction only if it's needed. Cars with already-perfect paint (new vehicles, well-maintained older ones) often don't need it.",
  },
  {
    question: "Can ceramic coating be applied to wheels, glass, and trim?",
    answer: "Yes. We offer ceramic coatings for wheels (which makes brake dust much easier to clean), windshield and side windows (which improves water beading at speed and reduces wiper wear), and exterior trim (which prevents plastic from fading and graying). These are add-ons to the main paint coating and can be quoted separately.",
  },
];

const title = `Ceramic Coating in North Palm Beach, FL | ${siteData.brand.name}`;
const description = `Professional ceramic coating in North Palm Beach from $800, priced by vehicle size. Drop off at 8 AM, pick up the same day.`;
const schema = generateServiceSchema({
  name: "Ceramic Coating",
  description: "Professional ceramic coating in North Palm Beach, FL. One package for every vehicle, priced by size. Same-day service.",
  url: "https://www.hectorcarwash.com/services/ceramic-coating",
  priceFrom: "800.00",
  faqs,
});
---

<BaseLayout title={title} description={description} schema={schema}>

  <PageHero
    title="Ceramic coating, done in a day."
    lead="A hard, clear layer bonded to your clear coat that protects against UV, salt and grime for years. One package for every car, priced by size."
    facts={['From $800', 'Drop off at 8 AM', 'Ready the same day']}
  >
    <div class="btn-row hero-btns">
      <a href="#book" class="btn btn-azure">Get a quote</a>
      <a href={`tel:${shop.phoneE164}`} class="btn btn-line">Call <span data-no-i18n>{shop.phone}</span></a>
    </div>
  </PageHero>

  <section class="section-tight">
    <div class="container-wide product">
      <div class="product-img">
        <img src="/images/ceramic-water-beading.jpg" alt="Water beading on freshly coated dark grey paint" width="1200" height="1200" />
      </div>
      <div>
        <h2 class="h-lg">Not a wax.</h2>
        <div class="prose">
          <p>Wax sits on top of the paint and washes away in weeks. A ceramic coating bonds with the clear coat and becomes part of the surface. Once it cures it's harder than the paint underneath, clear enough that you can't see it, and slick enough that rain beads straight off.</p>
          <p>The beading is what people notice. What matters more is what you don't see: UV protection that keeps paint from oxidizing, and resistance to bird droppings and tree sap that would otherwise etch bare paint within hours.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-wide package">
      <div>
        <h2 class="h-lg">One package. Every car.</h2>
        <p class="lede">No tiers and no upselling. Every car gets the same coating and the same process. The price changes only with the size and value of the car.</p>
        <div class="price-tag">
          <span class="from">From</span>
          <span class="amt" data-no-i18n>$800</span>
        </div>
        <p class="price-note">A coupe and a three-row SUV aren't the same job. Bigger cars take more product and more hours, and high-value cars often need more prep so the finish is flawless under the coating. We look at the car and give you the exact number before any work starts.</p>
      </div>
      <div class="package-list">
        <h3 class="h-sm">What's included</h3>
        <ul class="ticks">
          <li>Full hand wash and decontamination</li>
          <li>Clay-bar treatment to lift bonded contaminants</li>
          <li>Paint correction where it's needed</li>
          <li>Professional ceramic coating, applied by hand panel by panel</li>
          <li>9H hardness, water-repelling, UV and salt resistant</li>
          <li>Final inspection and a care guide to keep it looking right</li>
        </ul>
        <p class="addon">Coatings for wheels, glass and trim can be added and quoted at the same time. Warranty details are confirmed with your quote.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">One day, start to finish.</h2>
      </div>
      <ol class="steps">
        <li>
          <h3 class="h-sm">8 AM, drop off.</h3>
          <p>We walk around the car together and give you the exact price. Nothing starts until you've okayed it.</p>
        </li>
        <li>
          <h3 class="h-sm">Morning, prep.</h3>
          <p>Hand wash, iron remover and clay bar, then paint correction where it's needed. This is what decides how good the coating looks.</p>
        </li>
        <li>
          <h3 class="h-sm">Afternoon, coating.</h3>
          <p>Applied panel by panel out of dust and direct sun, leveled and buffed, then given time to set.</p>
        </li>
        <li>
          <h3 class="h-sm">Same day, pickup.</h3>
          <p>You drive home the same day with a care guide. Coated cars do best with regular pH-neutral hand washes, which is exactly what we do.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section on-ink why-fl">
    <div class="container-wide why">
      <h2 class="h-lg">Florida is hard on paint.</h2>
      <div class="prose">
        <p>High UV most of the year, salt air off the Atlantic and the Intracoastal, humidity, storm debris, and pollen that turns hoods yellow overnight. A coated car here holds its color longer, washes faster and resists the etching that makes a five-year-old car look ten.</p>
        <p>It's especially worth it on Teslas, whose factory paint is known for being soft.</p>
      </div>
    </div>
  </section>

  <section class="book section" id="book">
    <div class="container-narrow">
      <h2 class="h-lg">Get a ceramic quote.</h2>
      <p class="lede">Book a time below and tell us about the car. We'll give you an exact quote once we've seen it. No pressure, no sales call.</p>
      <div class="book-widget"><CalendlyInline /></div>
      <p class="book-alt">Prefer to call? <a href={`tel:${shop.phoneE164}`} data-no-i18n>{shop.phone}</a></p>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-narrow">
      <h2 class="h-lg faq-title">Ceramic coating questions.</h2>
      <FAQ faqs={faqs} />
    </div>
  </section>

  <EndCTA title="Protect the paint." lead="Ceramic coating on US-1 in North Palm Beach. From $800, done the same day." book={true} />

</BaseLayout>

<style>
  .hero-btns { margin-top: 32px; }
  .product { display: grid; grid-template-columns: 1fr 1.1fr; gap: 72px; align-items: center; }
  .product-img img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; object-position: 50% 100%; }
  .product h2 { margin-bottom: 28px; }
  .package { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .package .lede { margin-top: 20px; }
  .price-tag { display: flex; align-items: baseline; gap: 12px; margin: 36px 0 16px; }
  .from { font-size: 18px; font-weight: 600; color: var(--color-slate); }
  .amt { font-stretch: 125%; font-weight: 850; font-size: clamp(64px, 7vw, 104px); letter-spacing: -0.045em; line-height: 0.9; color: var(--color-azure-deep); }
  .price-note { margin: 0; font-size: 16px; line-height: 1.65; color: var(--color-slate); max-width: 34em; }
  .package-list { background: #fff; padding: 36px 36px 30px; }
  .package-list h3 { margin-bottom: 8px; }
  .addon { margin: 20px 0 0; font-size: 14.5px; color: var(--color-slate); }
  .why { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }
  .why-fl .prose p { color: rgba(255,255,255,0.85); }
  .book .lede { margin: 20px 0 36px; }
  .book-alt { margin: 20px 0 0; color: var(--color-slate); }
  .book-alt a { color: var(--color-ink); font-weight: 700; }
  .faq-title { margin-bottom: 36px; }
  @media (max-width: 900px) {
    .product, .package, .why { grid-template-columns: 1fr; gap: 40px; }
    .package-list { padding: 28px 22px; }
  }
</style>
