---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CalendlyInline from '../../components/CalendlyInline.astro';
import FAQ from '../../components/FAQ.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import EndCTA from '../../components/EndCTA.astro';
import reviewsData from '../../data/reviews.json';
import locationsData from '../../data/locations.json';
import siteData from '../../data/site.json';
import { generateServiceSchema } from '../../lib/schema';

const shop = locationsData.locations[0];
const detailReview = reviewsData.reviews.find((r) => r.service === 'detailing');

const faqs = [
  {
    question: "How long does full car detailing take?",
    answer: "A complete interior-and-exterior detail at Hector's takes between 4 and 6 hours depending on vehicle size and condition. SUVs and trucks usually take longer than sedans. We book one car per slot, so your appointment time is your time — no double-booking. You can drop off in the morning and pick up the same afternoon.",
  },
  {
    question: "What's the difference between a detail and a hand wash?",
    answer: "A hand wash cleans your car. A detail restores it. Washes focus on surface dirt — soap, rinse, dry, vacuum. Detailing goes deeper: clay-bar treatment that pulls embedded contaminants out of the clear coat, hot-water shampoo and extraction on carpets and upholstery, leather conditioning, plastic restoration, paint polishing to remove light swirl marks. A detail at Hector's is what your car gets two or three times a year. A wash is what it gets every week or two.",
  },
  {
    question: "How much does car detailing cost in Palm Beach County?",
    answer: "Our full detailing service starts at $300 for a standard sedan and ranges to $500+ for larger SUVs, trucks, and vehicles in heavier condition. The price depends on size and the work needed. Every detail includes interior shampoo, exterior polish, clay-bar treatment, wheel and tire dressing, and a thorough vacuum and wipe-down. We give you an exact quote before any work starts.",
  },
  {
    question: "Do I need an appointment for detailing?",
    answer: "Yes. Detailing is by appointment only — book through Calendly. We don't do detail work as a walk-in because each one takes hours and we want to give your car our full attention. Washes are walk-in. Details are scheduled.",
  },
  {
    question: "Will detailing get rid of pet hair, sand, and salt damage?",
    answer: "Pet hair: yes. We use specialized rubber tools and pneumatic vacuums that pull embedded pet hair out of fabric and carpets. Sand: yes, with high-suction extraction and brushes that get into seat seams and floor edges. Salt damage to paint and chrome: yes, with clay-bar and polish on paint, and chrome polish on trim — though salt corrosion that's already pitted metal can't be fully reversed. The earlier you bring the car in after salt exposure, the better.",
  },
  {
    question: "How often should I get my car detailed?",
    answer: "For most Palm Beach drivers, two to three times a year. Once before snowbird season (October), once mid-winter when salt air has had a few months to work on the paint, and once after hurricane season to remove debris and any storm-related grime. Daily drivers may need more. Garage-kept weekend cars can usually go six months or longer between details.",
  },
  {
    question: "Do you detail luxury and exotic vehicles?",
    answer: "Yes. Bentleys, Aston Martins, Mercedes, Porsche, Rolls-Royce, and Tesla all regularly come through Hector's. Our staff is trained on luxury finishes — including ceramic-coated paint, soft-touch interiors, and Tesla glass. If your car has a coating you want preserved, tell us at booking and we'll use coating-safe chemistry only.",
  },
  {
    question: "What if my car has stains, odors, or smoke damage?",
    answer: "Heavy interior conditions — pet odors, smoke, food stains, mold — need an enzyme treatment and ozone session that take additional time. We handle these on case-by-case basis; please mention any specific issues when you book. We'll quote separately for severe restoration work.",
  },
];

const title = `Car Detailing in North Palm Beach, FL | ${siteData.brand.name}`;
const description = `Full interior and exterior car detailing in North Palm Beach. Shampoo, clay bar, hand polish, leather conditioning. From $300, by appointment.`;
const schema = generateServiceSchema({
  name: "Car Detailing",
  description: "Full interior and exterior car detailing in North Palm Beach, FL.",
  url: "https://www.hectorcarwash.com/services/car-detailing",
  priceFrom: "300.00",
  faqs,
});
---

<BaseLayout title={title} description={description} schema={schema}>

  <PageHero
    title="Full detailing, by appointment."
    lead="Interior shampoo, clay bar, hand polish and leather conditioning, done by the same crew that hand-washes cars every day on US-1."
    facts={['From $300', '4 to 6 hours', 'North Palm Beach']}
  >
    <div class="btn-row hero-btns">
      <a href="#book" class="btn btn-azure">Book a detail</a>
      <a href={`tel:${shop.phoneE164}`} class="btn btn-line">Call <span data-no-i18n>{shop.phone}</span></a>
    </div>
  </PageHero>

  <div class="banner container-wide">
    <img src="/images/detail-hero.jpg" alt="A crew member polishing a grey Tesla" width="1600" height="800" />
  </div>

  <section class="section">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">The full job.</h2>
        <p class="lede">A detail here takes four to six hours. This is what that time goes into.</p>
      </div>
      <div class="included">
        <div>
          <h3 class="h-md">Inside</h3>
          <ul class="ticks">
            <li>Full vacuum: seats, floor, trunk, mats, every seam</li>
            <li>Hot-water shampoo and extraction on carpets and cloth seats</li>
            <li>Leather cleaned and conditioned</li>
            <li>Dashboard, console, door panels and vents wiped and dressed</li>
            <li>Streak-free glass, inside and out</li>
            <li>Headliner spot-cleaned</li>
          </ul>
        </div>
        <div>
          <h3 class="h-md">Outside</h3>
          <ul class="ticks">
            <li>Two-bucket hand wash with pH-balanced soap</li>
            <li>Clay-bar treatment to lift contaminants bonded to the clear coat</li>
            <li>Hand polish to remove light swirls and bring back gloss</li>
            <li>Wheel wells, tire dressing, chrome polished</li>
            <li>Door jambs, fuel door and hood gaps</li>
            <li>Hand dried with microfiber</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-wide why">
      <div>
        <h2 class="h-lg">A wash cleans the car. A detail restores it.</h2>
      </div>
      <div class="prose">
        <p>In Palm Beach County your car takes salt spray off the Atlantic, UV that fades plastic and leather, humidity that turns into mildew in the carpet, and sand from every beach trip.</p>
        <p>A weekly hand wash takes care of surface dirt. It doesn't reach what has worked into the clear coat over months. Run your hand across a freshly washed roof and you'll feel grit. The clay bar pulls that out, and the polish brings back the gloss it was hiding.</p>
        <p>Two or three details a year keeps the paint, leather and headlights in shape and helps the car hold its value.</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-wide gallery">
      <figure>
        <img src="/images/detail-interior-before-after.jpg" alt="Car floor mats before and after a detail" width="1600" height="1200" loading="lazy" />
        <figcaption>Interior, before and after.</figcaption>
      </figure>
      <figure>
        <img src="/images/detail-paint-correction.jpg" alt="Machine polishing the rear of a grey Tesla" width="1200" height="1200" loading="lazy" />
        <figcaption>Paint correction, mid-pass.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">How booking works.</h2>
      </div>
      <ol class="steps">
        <li>
          <h3 class="h-sm">Pick a time.</h3>
          <p>Book online and tell us the make, model and anything specific: pet hair, stains, a coating to protect.</p>
        </li>
        <li>
          <h3 class="h-sm">Drop the car off.</h3>
          <p>We walk around the car with you and confirm the price. If we find something that changes the job, we call before doing it.</p>
        </li>
        <li>
          <h3 class="h-sm">We work the car.</h3>
          <p>Inside first, then outside. One car per slot, so your appointment is your appointment.</p>
        </li>
        <li>
          <h3 class="h-sm">Walk through and pick up.</h3>
          <p>We go over the car together. Anything you're not happy with gets fixed on the spot.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="book on-ink section" id="book">
    <div class="container-narrow">
      <h2 class="h-lg">Book a detail.</h2>
      <p class="lede">Choose a date and time, tell us about the car, and we'll confirm.</p>
      <div class="book-widget"><CalendlyInline /></div>
      <p class="book-alt">Prefer to call? <a href={`tel:${shop.phoneE164}`} data-no-i18n>{shop.phone}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <h2 class="h-lg faq-title">Detailing questions.</h2>
      <FAQ faqs={faqs} />
    </div>
  </section>

  {detailReview && (
    <section class="section-tight bg-mist">
      <div class="container-narrow">
        <ReviewCard quote={detailReview.quote} author={detailReview.author} source={detailReview.source} variant="large" />
      </div>
    </section>
  )}

  <EndCTA title="Rather talk it through?" lead="Call the shop and tell us about the car. Detailing is by appointment, from $300." book={true} />

</BaseLayout>

<style>
  .hero-btns { margin-top: 32px; }
  .banner img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; }
  .included { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .included h3 { padding-bottom: 14px; border-bottom: 2px solid var(--color-ink); margin-bottom: 4px; }
  .why { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }
  .gallery { display: grid; grid-template-columns: 1.33fr 1fr; gap: 24px; align-items: end; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; height: auto; }
  .gallery figcaption { margin-top: 10px; font-size: 14px; color: var(--color-slate); }
  .book .lede { margin: 20px 0 36px; }
  .book-alt { margin: 20px 0 0; color: rgba(255,255,255,0.75); }
  .book-alt a { color: #fff; font-weight: 700; }
  .faq-title { margin-bottom: 36px; }
  @media (max-width: 860px) {
    .banner { padding: 0; }
    .banner img { aspect-ratio: 16 / 10; }
    .included, .why, .gallery { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
