---
// Google Ads landing page for detailing.
// v2 (Oct 21): calls and texts first. Week one sent 81 clicks, 1 call, 0 Calendly
// bookings, so the page now leads with Call / Text and keeps online booking as a
// fallback further down. A $300+ job is easier to say yes to after a quick conversation.
// No site nav or footer links. noindex + left out of the sitemap.
// Tracking (ConversionTracking.astro): tel: clicks = phone conversion, sms: clicks =
// GA event (+ Ads conversion once a label is added), Calendly bookings = booking conversion.
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendlyInline from '../components/CalendlyInline.astro';
import FAQ from '../components/FAQ.astro';
import OpenStatus from '../components/OpenStatus.astro';
import siteData from '../data/site.json';
import locationsData from '../data/locations.json';
import reviewsData from '../data/reviews.json';

const shop = locationsData.locations[0];
const TEL = `tel:${shop.phoneE164}`;

// Pre-filled text. "?&body=" works on both iPhone and Android.
// The Spanish version is swapped in by the script at the bottom when the page is in ES.
const SMS_EN = "Hi Hector's, I'd like a price for a full detail. My car is a ";
const SMS_ES = 'Hola Hector\'s, quiero un precio para un detallado completo. Mi auto es un ';
const smsHref = (body: string) => `sms:${shop.phoneE164}?&body=${encodeURIComponent(body)}`;

const CALENDLY =
  'https://calendly.com/hectorscarwash/30min?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=2e9cd6&text_color=122029';

const detailReview = reviewsData.reviews.find((r) => r.id === 'jayden-anthony');
const reviews = ['riley-ziegler', 'christopher-schalk', 'nico']
  .map((id) => reviewsData.reviews.find((r) => r.id === id))
  .filter(Boolean);

const title = `Car Detailing in North Palm Beach | Call or Text | ${siteData.brand.name}`;
const description = `Full interior and exterior detailing at Hector's on US Highway 1 in North Palm Beach. From $300, same-day. Call or text ${shop.phone} for a price and the next open day.`;

const faqs = [
  {
    question: 'How much does a detail cost?',
    answer: "From $300 for a sedan. Larger SUVs, trucks and cars in heavier condition cost more. Text us the make and model, and a photo if you can, and we'll give you a price. The exact number is confirmed at drop-off before any work starts.",
  },
  {
    question: 'Can I just text you?',
    answer: "Yes. Text the make and model and when you'd like to come in. Photos of the inside help us quote. If we're closed, we reply when we open.",
  },
  {
    question: 'How long does it take?',
    answer: 'Four to six hours, depending on the size and condition of the car. Most people drop off in the morning and pick up the same afternoon.',
  },
  {
    question: 'Do I pay anything up front?',
    answer: "No. You pay at the shop when you pick up the car.",
  },
  {
    question: 'Do you detail luxury cars and Teslas?',
    answer: "Every week. Bentleys, Porsches, Mercedes and Teslas come through regularly. The crew is trained on coated paint, soft-touch interiors and Tesla glass.",
  },
];

const star = 'M10 1.5l2.6 5.5 6 .7-4.5 4.1 1.2 5.9L10 14.8l-5.3 2.9 1.2-5.9L1.4 7.7l6-.7z';
const phoneIcon = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z';
const textIcon = 'M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2z';
---

<BaseLayout title={title} description={description} bare={true} noindex={true}>

  <header class="lp-top">
    <div class="container-wide lp-top-row">
      <span class="lp-brand">
        <img src="/images/hectors-car-wash-logo.png" alt="" width="40" height="40" />
        <span data-no-i18n>Hector's<span class="lp-brand-full"> Car Wash</span></span>
      </span>
      <div class="lp-top-right">
        <div class="lang-toggle" role="group" aria-label="Language" data-no-i18n>
          <button type="button" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
          <button type="button" data-lang="es" aria-pressed="false" aria-label="Español">ES</button>
        </div>
        <a href={TEL} class="lp-call" data-cta="header">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d={phoneIcon}/></svg>
          <span data-no-i18n>{shop.phone}</span>
        </a>
      </div>
    </div>
  </header>

  {/* ============ HERO: CALL / TEXT ============ */}
  <section class="lp-hero">
    <div class="container-wide lp-grid">
      <div class="lp-copy">
        <a href="#reviews" class="rating">
          <span class="stars" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" width="16" height="16"><path fill="currentColor" d={star} /></svg>)}
          </span>
          <span><strong data-no-i18n>{siteData.brand.rating}</strong> from {siteData.brand.reviewCount}+ Google reviews</span>
        </a>
        <h1 class="h-xl">Full car detailing in North Palm Beach.</h1>
        <p class="lede">Call or text for a price and the next open day. Inside and out, by hand, done the same day.</p>

        <div class="contact">
          <OpenStatus class="contact-status" />
          <div class="contact-btns">
            <a href={TEL} class="cbtn cbtn-call" data-cta="hero">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d={phoneIcon}/></svg>
              <span class="cbtn-text">
                <span class="cbtn-label">Call now</span>
                <span class="cbtn-sub" data-no-i18n>{shop.phone}</span>
              </span>
            </a>
            <a href={smsHref(SMS_EN)} class="cbtn cbtn-text-us" data-sms data-cta="hero">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d={textIcon}/></svg>
              <span class="cbtn-text">
                <span class="cbtn-label">Text us</span>
                <span class="cbtn-sub">Get a price by text</span>
              </span>
            </a>
          </div>
          <p class="contact-note">Texting? Send the make and model, plus a photo if you can. We reply with a price and an open time.</p>
          <p class="closed-note">We're closed right now. Text anytime and we'll reply as soon as we open.</p>
        </div>

        <ul class="lp-facts">
          <li><strong>From $300</strong><span>Exact price before we start</span></li>
          <li><strong>4 to 6 hours</strong><span>Same-day pickup</span></li>
          <li class="hide-sm"><strong>One car per slot</strong><span>Your time is your time</span></li>
        </ul>
      </div>

      <figure class="hero-photo">
        <img src="/images/story-hector-working.jpg" alt="A Hector's crew member hand-finishing a white sports car" width="1200" height="1500" fetchpriority="high" />
        {detailReview && (
          <figcaption class="hero-quote">
            <span class="stars" aria-hidden="true">
              {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" width="14" height="14"><path fill="currentColor" d={star} /></svg>)}
            </span>
            <span class="hq-text" data-no-i18n>“{detailReview.shortQuote}”</span>
            <span class="hq-who"><strong data-no-i18n>{detailReview.author}</strong>, detail customer</span>
          </figcaption>
        )}
      </figure>
    </div>
  </section>

  {/* ============ RESULTS ============ */}
  <section class="section results">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">The difference a detail makes.</h2>
        <p class="lede">Real cars from our shop on US-1.</p>
      </div>
      <div class="gallery">
        <figure class="g-big">
          <img src="/images/detail-interior-before-after.jpg" alt="Floor mats before and after a Hector's detail" width="1600" height="1200" loading="lazy" />
          <figcaption>Interior, before and after.</figcaption>
        </figure>
        <figure>
          <img src="/images/detail-paint-correction.jpg" alt="Machine polishing the rear of a grey Tesla" width="1200" height="1200" loading="lazy" />
          <figcaption>Paint correction, mid-pass.</figcaption>
        </figure>
        <figure>
          <img src="/images/detail-hero.jpg" alt="Polishing the paint on a grey Tesla" width="1600" height="800" loading="lazy" />
          <figcaption>Hand polish for gloss.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ============ WHAT'S INCLUDED ============ */}
  <section class="section bg-mist">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">Everything in a full detail.</h2>
        <p class="lede">One package, inside and out. No upsell menu at the counter.</p>
      </div>
      <div class="inc-cols">
        <div>
          <h3 class="h-sm">Inside</h3>
          <ul class="ticks">
            <li>Full vacuum, seats, trunk and every seam</li>
            <li>Hot-water shampoo on carpets and cloth</li>
            <li>Leather cleaned and conditioned</li>
            <li>Dash, console, doors and vents dressed</li>
            <li>Streak-free glass, inside and out</li>
          </ul>
        </div>
        <div>
          <h3 class="h-sm">Outside</h3>
          <ul class="ticks">
            <li>Two-bucket hand wash</li>
            <li>Clay-bar treatment</li>
            <li>Hand polish for gloss and light swirls</li>
            <li>Wheels, tires, wells and chrome</li>
            <li>Door jambs, hand dried with microfiber</li>
          </ul>
        </div>
      </div>
      <div class="mid-cta">
        <a href={TEL} class="btn btn-ink" data-cta="mid">Call <span data-no-i18n>{shop.phone}</span></a>
        <a href={smsHref(SMS_EN)} class="btn btn-azure" data-sms data-cta="mid">Text us for a price</a>
      </div>
    </div>
  </section>

  {/* ============ REVIEWS ============ */}
  <section class="section" id="reviews">
    <div class="container-wide">
      <div class="rev-head">
        <h2 class="h-lg">Why North Palm Beach comes back.</h2>
        <div class="rev-score">
          <span class="score" data-no-i18n>{siteData.brand.rating}</span>
          <span class="stars" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" width="18" height="18"><path fill="currentColor" d={star} /></svg>)}
          </span>
          <span class="rev-count">{siteData.brand.reviewCount}+ Google reviews</span>
        </div>
      </div>
      <div class="rev-grid">
        {reviews.map((r) => (
          <figure class="q">
            <blockquote data-no-i18n><p>“{r!.shortQuote}”</p></blockquote>
            <figcaption><strong data-no-i18n>{r!.author}</strong>, Google review</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ============ HECTOR ============ */}
  <section class="section-tight bg-mist">
    <div class="container-wide owner">
      <img src="/images/about-hector-portrait.jpg" alt="Hector David Ramirez, owner" width="1600" height="2000" loading="lazy" />
      <div>
        <h2 class="h-md">Hector is on the lot every day.</h2>
        <p>Almost thirty years of washing and detailing cars, and since 2019 under his own name. He hires and trains the crew that works on your car, and he's there when you pick it up.</p>
      </div>
    </div>
  </section>

  {/* ============ HOW IT WORKS ============ */}
  <section class="section">
    <div class="container-wide">
      <h2 class="h-lg steps-title">How it works.</h2>
      <ol class="steps">
        <li>
          <h3 class="h-sm">Call or text.</h3>
          <p>Tell us the make and model. We'll give you a price and the next open day.</p>
        </li>
        <li>
          <h3 class="h-sm">Drop it off.</h3>
          <p>We walk around the car with you and confirm the price before starting.</p>
        </li>
        <li>
          <h3 class="h-sm">We detail it.</h3>
          <p>One car per slot. If we find something that changes the job, we call first.</p>
        </li>
        <li>
          <h3 class="h-sm">Pick it up.</h3>
          <p>We go over the car together. Anything you're not happy with gets fixed on the spot.</p>
        </li>
      </ol>
    </div>
  </section>

  {/* ============ BOOK ONLINE (fallback) ============ */}
  <section class="section bg-mist" id="calendar">
    <div class="container-narrow">
      <h2 class="h-lg">Rather book online?</h2>
      <p class="lede cal-lede">Pick a drop-off day and time. Free to book, no card needed.</p>
      <div class="cal-box">
        <CalendlyInline url={CALENDLY} height={680} fallbackText="Calendar not loading? Open it in a new tab" />
      </div>
    </div>
  </section>

  {/* ============ FAQ ============ */}
  <section class="section">
    <div class="container-narrow">
      <h2 class="h-lg faq-title">Before you call.</h2>
      <FAQ faqs={faqs} />
    </div>
  </section>

  {/* ============ CLOSE ============ */}
  <section class="lp-close on-ink">
    <div class="container-wide close-grid">
      <div>
        <h2 class="h-lg">Get a price in one call.</h2>
        <p class="lede">From $300. Same-day pickup. 900 US Highway 1, North Palm Beach.</p>
      </div>
      <div class="btn-row stack">
        <a href={TEL} class="btn btn-azure" data-cta="close">Call <span data-no-i18n>{shop.phone}</span></a>
        <a href={smsHref(SMS_EN)} class="btn btn-line" data-sms data-cta="close">Text us</a>
      </div>
    </div>
    <p class="lp-legal container-wide">© {new Date().getFullYear()} <span data-no-i18n>Hector's Car Wash</span>, 900 US Highway 1, North Palm Beach, FL 33408. Mon–Sat 8:00 AM – 5:30 PM, Sun 9:00 AM – 4:00 PM.</p>
  </section>

  {/* Mobile: Call and Text always one tap away */}
  <nav class="lp-bar" aria-label="Contact">
    <a href={TEL} class="bar-btn bar-call" data-cta="bar">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d={phoneIcon}/></svg>
      <span>Call</span>
    </a>
    <a href={smsHref(SMS_EN)} class="bar-btn bar-text" data-sms data-cta="bar">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d={textIcon}/></svg>
      <span>Text</span>
    </a>
  </nav>

</BaseLayout>

<script is:inline define:vars={{ smsEn: smsHref(SMS_EN), smsEs: smsHref(SMS_ES) }}>
  (function () {
    // Swap the pre-filled text message to Spanish when the page is in ES.
    function setSms() {
      var es = document.documentElement.lang === 'es';
      document.querySelectorAll('a[data-sms]').forEach(function (a) { a.setAttribute('href', es ? smsEs : smsEn); });
    }
    setSms();
    new MutationObserver(setSms).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });

    // Bottom bar slides in once the big Call/Text buttons scroll out of view.
    var bar = document.querySelector('.lp-bar');
    var hero = document.querySelector('.contact-btns');
    if (bar && hero && 'IntersectionObserver' in window) {
      bar.classList.add('auto');
      new IntersectionObserver(function (es) { bar.classList.toggle('show', !es[0].isIntersecting); }).observe(hero);
    }
  })();
</script>

<style>
  /* ---------- slim header ---------- */
  .lp-top { border-bottom: 1px solid var(--color-line); background: #fff; }
  .lp-top-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
  .lp-brand { display: inline-flex; align-items: center; gap: 10px; font-stretch: 125%; font-weight: 800; font-size: 18px; letter-spacing: -0.02em; }
  .lp-brand img { width: 40px; height: 40px; }
  .lp-top-right { display: flex; align-items: center; gap: 10px; }
  .lp-call {
    display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: 999px;
    background: var(--color-ink); color: #fff; font-stretch: 110%; font-weight: 700; font-size: 15px; text-decoration: none;
  }
  .lang-toggle { display: inline-flex; border: 1.5px solid var(--color-line); border-radius: 999px; padding: 2px; }
  .lang-toggle button { appearance: none; border: 0; background: transparent; font: inherit; font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 999px; color: var(--color-slate); cursor: pointer; }
  .lang-toggle button[aria-pressed='true'] { background: var(--color-ink); color: #fff; }

  .stars { display: inline-flex; gap: 1px; color: var(--color-curb); }

  /* ---------- hero ---------- */
  .lp-hero { padding: 48px 0 80px; background: var(--color-mist); }
  .lp-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 64px; align-items: center; }
  .rating { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 18px; font-size: 15px; color: var(--color-ink); text-decoration: none; }
  .rating strong { font-weight: 800; }
  .lp-copy h1 { font-size: clamp(38px, 4.6vw, 66px); }
  .lp-copy .lede { margin-top: 18px; }

  .contact { margin-top: 30px; }
  .contact :global(.contact-status) { margin-bottom: 14px; }
  .contact-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 520px; }
  .cbtn {
    display: flex; align-items: center; gap: 14px; min-height: 72px; padding: 12px 20px;
    border-radius: 18px; text-decoration: none; transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .cbtn:active { transform: scale(0.98); }
  .cbtn svg { width: 26px; height: 26px; flex-shrink: 0; }
  .cbtn-text { display: flex; flex-direction: column; line-height: 1.15; }
  .cbtn-label { font-stretch: 118%; font-weight: 800; font-size: 20px; letter-spacing: -0.01em; }
  .cbtn-sub { font-size: 14px; font-weight: 600; opacity: 0.85; margin-top: 3px; }
  .cbtn-call { background: var(--color-ink); color: #fff; }
  .cbtn-call:hover { background: var(--color-azure-deep); }
  .cbtn-text-us { background: var(--color-azure); color: var(--color-ink); }
  .cbtn-text-us:hover { background: #4FB0E3; }
  .contact-note, .closed-note { margin: 14px 0 0; font-size: 14.5px; line-height: 1.5; color: var(--color-slate); max-width: 34em; }
  .closed-note { display: none; font-weight: 600; color: var(--color-ink); }
  .contact:has(.open-status:not(.is-open)) .closed-note { display: block; }

  .lp-facts { list-style: none; margin: 32px 0 0; padding: 0; border-top: 2px solid var(--color-ink); max-width: 520px; }
  .lp-facts li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-line); }
  .lp-facts strong { font-stretch: 118%; font-weight: 800; font-size: 18px; letter-spacing: -0.01em; }
  .lp-facts span { font-size: 15px; color: var(--color-slate); text-align: right; }

  .hero-photo { margin: 0; position: relative; }
  .hero-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 45% 40%; }
  .hero-quote {
    position: absolute; left: -32px; right: 32px; bottom: 28px;
    display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; background: #fff;
    box-shadow: 0 24px 50px -28px rgba(18,32,41,0.5);
  }
  .hq-text { font-weight: 600; font-size: 16.5px; line-height: 1.4; }
  .hq-who { font-size: 14px; color: var(--color-slate); }
  .hq-who strong { color: var(--color-ink); }

  /* ---------- results ---------- */
  .gallery { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 20px; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .g-big { display: flex; flex-direction: column; }
  .gallery .g-big img { aspect-ratio: auto; flex: 1; min-height: 0; }
  .gallery figcaption { margin-top: 10px; font-size: 14px; color: var(--color-slate); }

  /* ---------- included ---------- */
  .inc-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .inc-cols h3 { padding-bottom: 12px; border-bottom: 2px solid var(--color-ink); }
  .mid-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 48px; }

  /* ---------- reviews ---------- */
  .rev-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px; margin-bottom: 48px; }
  .rev-head h2 { max-width: 12em; }
  .rev-score { display: grid; grid-template-columns: auto auto; column-gap: 14px; align-items: center; }
  .score { grid-row: span 2; font-stretch: 125%; font-weight: 850; font-size: 64px; letter-spacing: -0.05em; line-height: 0.9; color: var(--color-azure); }
  .rev-count { font-size: 14px; color: var(--color-slate); }
  .rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .q { margin: 0; border-top: 2px solid var(--color-ink); padding-top: 22px; }
  .q blockquote { margin: 0 0 12px; }
  .q p { margin: 0; font-weight: 600; font-size: 18px; line-height: 1.45; }
  .q figcaption { font-size: 14.5px; color: var(--color-slate); }
  .q strong { color: var(--color-ink); }

  /* ---------- owner ---------- */
  .owner { display: grid; grid-template-columns: 160px 1fr; gap: 36px; align-items: center; max-width: 880px; }
  .owner img { width: 160px; height: 160px; object-fit: cover; border-radius: 50%; }
  .owner p { margin: 12px 0 0; font-size: 17px; line-height: 1.65; color: var(--color-slate); max-width: 36em; }

  .steps-title { margin-bottom: 48px; }
  .faq-title { margin-bottom: 36px; }

  /* ---------- calendar (fallback) ---------- */
  .cal-lede { margin: 16px 0 28px; }
  .cal-box { background: #fff; border-top: 6px solid var(--color-azure); }
  .cal-box :global(.calendly-wrap) { max-width: none; }

  /* ---------- close ---------- */
  .lp-close { padding: 88px 0 32px; }
  .close-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: end; }
  .close-grid .lede { margin-top: 18px; }
  .close-grid .btn-row { justify-content: flex-end; }
  .lp-legal { margin-top: 72px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,0.14); font-size: 13.5px; color: rgba(255,255,255,0.55); }

  .lp-bar { display: none; }

  @media (max-width: 960px) {
    .lp-hero { padding: 20px 0 32px; }
    .lp-grid { grid-template-columns: 1fr; gap: 28px; }
    .rating { margin-bottom: 10px; font-size: 14px; }
    .lp-copy h1 { font-size: clamp(32px, 8.6vw, 44px); }
    .lp-copy .lede { margin-top: 12px; font-size: 17px; }
    .contact { margin-top: 20px; }
    .contact-btns { max-width: none; }
    .lp-facts { margin-top: 22px; display: grid; grid-template-columns: 1fr 1fr; max-width: none; border-bottom: 1px solid var(--color-line); }
    .lp-facts li { flex-direction: column; gap: 2px; border-bottom: 0; padding: 12px 0; }
