---
// Google Ads landing page for detailing bookings.
// Built for one action: book a drop-off time in the embedded Calendly. Calling is the backup.
// No site nav or footer links. noindex + left out of the sitemap so it doesn't
// compete with /services/car-detailing in organic search.
// Calendly completions fire the booking conversion in ConversionTracking.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendlyInline from '../components/CalendlyInline.astro';
import FAQ from '../components/FAQ.astro';
import siteData from '../data/site.json';
import locationsData from '../data/locations.json';
import reviewsData from '../data/reviews.json';

const shop = locationsData.locations[0];

// hide_event_type_details: hides the Calendly event name and "30 min" label, which
// would contradict the 4 to 6 hour job. The rest matches the site's colors.
const CALENDLY =
  'https://calendly.com/hectorscarwash/30min?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=2e9cd6&text_color=122029';

const detailReview = reviewsData.reviews.find((r) => r.id === 'jayden-anthony');
const reviews = ['riley-ziegler', 'christopher-schalk', 'nico']
  .map((id) => reviewsData.reviews.find((r) => r.id === id))
  .filter(Boolean);

const title = `Book a Car Detail in North Palm Beach | ${siteData.brand.name}`;
const description = `Book a full interior and exterior detail at Hector's on US Highway 1 in North Palm Beach. From $300, four to six hours, one car per slot.`;

const faqs = [
  {
    question: 'How much does a detail cost?',
    answer: "From $300 for a sedan. Larger SUVs, trucks and cars in heavier condition cost more. We look at the car at drop-off and give you the exact price before any work starts.",
  },
  {
    question: 'Do I pay to book?',
    answer: "No. Booking is free and there's no card to enter. You pay at the shop.",
  },
  {
    question: 'How long does it take?',
    answer: 'Four to six hours, depending on the size and condition of the car. Most people drop off in the morning and pick up the same afternoon.',
  },
  {
    question: 'What should I tell you when I book?',
    answer: "The make and model, and anything specific: pet hair, stains, odors, sand, or a ceramic coating you want protected. It helps us plan the time and the products.",
  },
  {
    question: 'Do you detail luxury cars and Teslas?',
    answer: "Every week. Bentleys, Porsches, Mercedes and Teslas come through regularly. The crew is trained on coated paint, soft-touch interiors and Tesla glass.",
  },
  {
    question: 'What if I need to reschedule?',
    answer: 'Use the link in your Calendly confirmation email to pick a new time, or call the shop.',
  },
];

const star = 'M10 1.5l2.6 5.5 6 .7-4.5 4.1 1.2 5.9L10 14.8l-5.3 2.9 1.2-5.9L1.4 7.7l6-.7z';
---

<BaseLayout title={title} description={description} bare={true} noindex={true}>

  <header class="lp-top">
    <div class="container-wide lp-top-row">
      <span class="lp-brand">
        <img src="/images/hectors-car-wash-logo.png" alt="" width="40" height="40" />
        <span data-no-i18n>Hector's<span class="lp-brand-full"> Car Wash</span></span>
      </span>
      <div class="lp-top-right">
        <div class="lang-toggle" role="group" aria-label="Language" data-no-i18n>
          <button type="button" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
          <button type="button" data-lang="es" aria-pressed="false" aria-label="Español">ES</button>
        </div>
        <a href={`tel:${shop.phoneE164}`} class="lp-call">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
          <span data-no-i18n>{shop.phone}</span>
        </a>
      </div>
    </div>
  </header>

  {/* ============ HERO + CALENDAR ============ */}
  <section class="lp-hero">
    <div class="container-wide lp-grid">
      <div class="lp-copy">
        <a href="#reviews" class="rating">
          <span class="stars" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" width="16" height="16"><path fill="currentColor" d={star} /></svg>)}
          </span>
          <span><strong data-no-i18n>{siteData.brand.rating}</strong> from {siteData.brand.reviewCount}+ Google reviews</span>
        </a>
        <h1 class="h-xl">Book a full detail in North Palm Beach.</h1>
        <p class="lede">Inside and out, by hand, on US Highway 1. Drop it off in the morning, drive home in a car that looks better than the day you bought it.</p>
        <ul class="lp-facts">
          <li><strong>From $300</strong><span>Exact price before we start</span></li>
          <li><strong>4 to 6 hours</strong><span>Same-day pickup</span></li>
          <li class="hide-sm"><strong>One car per slot</strong><span>Your time is your time</span></li>
        </ul>

        {detailReview && (
          <figure class="hero-quote">
            <span class="q-mark" aria-hidden="true" data-no-i18n>“</span>
            <div>
              <blockquote data-no-i18n><p>{detailReview.shortQuote}</p></blockquote>
              <figcaption><strong data-no-i18n>{detailReview.author}</strong>, detail customer</figcaption>
            </div>
          </figure>
        )}
      </div>

      <div class="lp-cal" id="calendar">
        <div class="lp-cal-head">
          <span class="step" data-no-i18n>1</span>
          <div>
            <h2 class="h-sm">Pick your drop-off day and time</h2>
            <p>Takes under a minute. We'll confirm by email.</p>
          </div>
        </div>
        <div class="cal-body">
          <div class="cal-loading" aria-hidden="true">
            <span class="spinner"></span>
            <span>Loading open times…</span>
          </div>
          <CalendlyInline url={CALENDLY} eager={true} height={680} fallbackText="Calendar not loading? Open it in a new tab" />
        </div>
        <ul class="assure">
          <li>Free to book, no card</li>
          <li>Price confirmed before work starts</li>
          <li>Not happy? Fixed on the spot</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ============ RESULTS ============ */}
  <section class="section results">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">The difference a detail makes.</h2>
        <p class="lede">Real cars from our shop on US-1.</p>
      </div>
      <div class="gallery">
        <figure class="g-big">
          <img src="/images/detail-interior-before-after.jpg" alt="Floor mats before and after a Hector's detail" width="1600" height="1200" loading="lazy" />
          <figcaption>Interior, before and after.</figcaption>
        </figure>
        <figure>
          <img src="/images/story-hector-working.jpg" alt="A crew member hand-finishing a white sports car" width="1200" height="1500" loading="lazy" />
          <figcaption>Hand finish, every panel.</figcaption>
        </figure>
        <figure>
          <img src="/images/detail-hero.jpg" alt="Polishing the paint on a grey Tesla" width="1600" height="800" loading="lazy" />
          <figcaption>Hand polish for gloss.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ============ WHAT'S INCLUDED ============ */}
  <section class="section bg-mist">
    <div class="container-wide">
      <div class="section-head">
        <h2 class="h-lg">Everything in a full detail.</h2>
        <p class="lede">One package, inside and out. No upsell menu at the counter.</p>
      </div>
      <div class="inc-cols">
        <div>
          <h3 class="h-sm">Inside</h3>
          <ul class="ticks">
            <li>Full vacuum, seats, trunk and every seam</li>
            <li>Hot-water shampoo on carpets and cloth</li>
            <li>Leather cleaned and conditioned</li>
            <li>Dash, console, doors and vents dressed</li>
            <li>Streak-free glass, inside and out</li>
          </ul>
        </div>
        <div>
          <h3 class="h-sm">Outside</h3>
          <ul class="ticks">
            <li>Two-bucket hand wash</li>
            <li>Clay-bar treatment</li>
            <li>Hand polish for gloss and light swirls</li>
            <li>Wheels, tires, wells and chrome</li>
            <li>Door jambs, hand dried with microfiber</li>
          </ul>
        </div>
      </div>
      <div class="mid-cta">
        <a href="#calendar" class="btn btn-azure" data-cta="mid">Pick a drop-off time</a>
        <span>or call <a href={`tel:${shop.phoneE164}`} data-no-i18n>{shop.phone}</a></span>
      </div>
    </div>
  </section>

  {/* ============ REVIEWS ============ */}
  <section class="section" id="reviews">
    <div class="container-wide">
      <div class="rev-head">
        <h2 class="h-lg">Why North Palm Beach comes back.</h2>
        <div class="rev-score">
          <span class="score" data-no-i18n>{siteData.brand.rating}</span>
          <span class="stars" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" width="18" height="18"><path fill="currentColor" d={star} /></svg>)}
          </span>
          <span class="rev-count">{siteData.brand.reviewCount}+ Google reviews</span>
        </div>
      </div>
      <div class="rev-grid">
        {reviews.map((r) => (
          <figure class="q">
            <blockquote data-no-i18n><p>“{r!.shortQuote}”</p></blockquote>
            <figcaption><strong data-no-i18n>{r!.author}</strong>, Google review</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ============ HECTOR ============ */}
  <section class="section-tight bg-mist">
    <div class="container-wide owner">
      <img src="/images/about-hector-portrait.jpg" alt="Hector David Ramirez, owner" width="1600" height="2000" loading="lazy" />
      <div>
        <h2 class="h-md">Hector is on the lot every day.</h2>
        <p>Almost thirty years of washing and detailing cars, and since 2019 under his own name. He hires and trains the crew that works on your car, and he's there when you pick it up.</p>
      </div>
    </div>
  </section>

  {/* ============ HOW IT WORKS ============ */}
  <section class="section">
    <div class="container-wide">
      <h2 class="h-lg steps-title">How it works.</h2>
      <ol class="steps">
        <li>
          <h3 class="h-sm">Book a time.</h3>
          <p>Pick a drop-off slot above and tell us the make, model and anything specific.</p>
        </li>
        <li>
          <h3 class="h-sm">Drop it off.</h3>
          <p>We walk around the car with you and confirm the price before starting.</p>
        </li>
        <li>
          <h3 class="h-sm">We detail it.</h3>
          <p>One car per slot. If we find something that changes the job, we call first.</p>
        </li>
        <li>
          <h3 class="h-sm">Pick it up.</h3>
          <p>We go over the car together. Anything you're not happy with gets fixed on the spot.</p>
        </li>
      </ol>
    </div>
  </section>

  {/* ============ FAQ ============ */}
  <section class="section bg-mist">
    <div class="container-narrow">
      <h2 class="h-lg faq-title">Before you book.</h2>
      <FAQ faqs={faqs} />
    </div>
  </section>

  {/* ============ CLOSE ============ */}
  <section class="lp-close on-ink">
    <div class="container-wide close-grid">
      <div>
        <h2 class="h-lg">Your car, back to its best.</h2>
        <p class="lede">From $300. Same-day pickup. 900 US Highway 1, North Palm Beach.</p>
      </div>
      <div class="btn-row stack">
        <a href="#calendar" class="btn btn-azure" data-cta="close">Pick a drop-off time</a>
        <a href={`tel:${shop.phoneE164}`} class="btn btn-line">Call <span data-no-i18n>{shop.phone}</span></a>
      </div>
    </div>
    <p class="lp-legal container-wide">© {new Date().getFullYear()} <span data-no-i18n>Hector's Car Wash</span>, 900 US Highway 1, North Palm Beach, FL 33408. Mon–Sat 8:00 AM – 5:30 PM, Sun 9:00 AM – 4:00 PM.</p>
  </section>

  {/* Mobile: both actions stay in reach whenever the calendar is off screen */}
  <div class="lp-bar" id="lpBar" aria-hidden="true">
    <a href="#calendar" class="btn btn-azure" tabindex="-1" data-cta="bar">Pick a time</a>
    <a href={`tel:${shop.phoneE164}`} class="btn btn-ink" tabindex="-1">Call</a>
  </div>

</BaseLayout>

<script is:inline>
  (function () {
    // Sticky bar: show whenever the calendar is fully out of view (above or below).
    var bar = document.getElementById('lpBar');
    var cal = document.getElementById('calendar');
    if (bar && cal && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) {
        var off = !es[0].isIntersecting;
        bar.classList.toggle('show', off);
        bar.setAttribute('aria-hidden', off ? 'false' : 'true');
        bar.querySelectorAll('a').forEach(function (a) { a.tabIndex = off ? 0 : -1; });
      }, { threshold: 0.15 }).observe(cal);
    }

    // Hide the loading note once Calendly's iframe reports in.
    window.addEventListener('message', function (e) {
      if (e.data && typeof e.data.event === 'string' && e.data.event.indexOf('calendly.') === 0) {
        var l = document.querySelector('.cal-loading');
        if (l) l.classList.add('done');
      }
    });
    // Fallback: hide it after the iframe has had time to paint.
    setTimeout(function () {
      var l = document.querySelector('.cal-loading');
      if (l) l.classList.add('done');
    }, 6000);
  })();
</script>

<style>
  /* ---------- slim header ---------- */
  .lp-top { border-bottom: 1px solid var(--color-line); background: #fff; }
  .lp-top-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
  .lp-brand { display: inline-flex; align-items: center; gap: 10px; font-stretch: 125%; font-weight: 800; font-size: 18px; letter-spacing: -0.02em; }
  .lp-brand img { width: 40px; height: 40px; }
  .lp-top-right { display: flex; align-items: center; gap: 10px; }
  .lp-call {
    display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: 999px;
    background: var(--color-ink); color: #fff; font-stretch: 110%; font-weight: 700; font-size: 15px; text-decoration: none;
  }
  .lang-toggle { display: inline-flex; border: 1.5px solid var(--color-line); border-radius: 999px; padding: 2px; }
  .lang-toggle button { appearance: none; border: 0; background: transparent; font: inherit; font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 999px; color: var(--color-slate); cursor: pointer; }
  .lang-toggle button[aria-pressed='true'] { background: var(--color-ink); color: #fff; }

  .stars { display: inline-flex; gap: 1px; color: var(--color-curb); }

  /* ---------- hero + calendar ---------- */
  .lp-hero { padding: 48px 0 80px; background: var(--color-mist); }
  .lp-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 56px; align-items: start; }
  .lp-copy { position: sticky; top: 24px; padding-top: 8px; }
  .rating {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: 20px;
    font-size: 15px; color: var(--color-ink); text-decoration: none;
  }
  .rating strong { font-weight: 800; }
  .lp-copy h1 { font-size: clamp(38px, 4.4vw, 64px); }
  .lp-copy .lede { margin-top: 20px; }
  .lp-facts { list-style: none; margin: 32px 0 0; padding: 0; border-top: 2px solid var(--color-ink); }
  .lp-facts li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--color-line); }
  .lp-facts strong { font-stretch: 118%; font-weight: 800; font-size: 19px; letter-spacing: -0.01em; }
  .lp-facts span { font-size: 15px; color: var(--color-slate); text-align: right; }

  .hero-quote { display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: start; margin: 28px 0 0; padding: 20px 22px; background: #fff; }
  .q-mark { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--color-azure); color: var(--color-ink); font-stretch: 125%; font-weight: 850; font-size: 34px; line-height: 1; padding-top: 12px; }
  .hero-quote blockquote { margin: 0 0 4px; }
  .hero-quote p { margin: 0; font-weight: 600; font-size: 16.5px; line-height: 1.4; }
  .hero-quote figcaption { font-size: 14px; color: var(--color-slate); }
  .hero-quote strong { color: var(--color-ink); }

  .lp-cal { background: #fff; box-shadow: 0 30px 70px -36px rgba(18, 32, 41, 0.45); border-top: 8px solid var(--color-azure); }
  .lp-cal-head { display: flex; align-items: center; gap: 14px; padding: 20px 24px 8px; }
  .step {
    flex-shrink: 0; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: var(--color-azure); color: var(--color-ink); font-stretch: 125%; font-weight: 800;
  }
  .lp-cal-head p { margin: 2px 0 0; font-size: 14px; color: var(--color-slate); }
  .cal-body { position: relative; min-height: 680px; }
  .cal-body :global(.calendly-wrap) { padding: 0 4px; max-width: none; background: transparent; }
  .cal-loading {
    position: absolute; inset: 0 0 auto; height: 320px; z-index: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    font-size: 15px; color: var(--color-slate); pointer-events: none; transition: opacity 0.3s ease;
  }
  .cal-loading.done { opacity: 0; }
  .cal-body :global(.calendly-inline-widget) { position: relative; z-index: 1; }
  .spinner { width: 28px; height: 28px; border-radius: 50%; border: 3px solid var(--color-mist-deep); border-top-color: var(--color-azure); animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
  .assure {
    list-style: none; margin: 0; padding: 16px 24px 20px; border-top: 1px solid var(--color-line);
    display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 14px; font-weight: 600;
  }
  .assure li { position: relative; padding-left: 20px; }
  .assure li::before {
    content: ''; position: absolute; left: 2px; top: 5px; width: 10px; height: 5px;
    border-left: 2.5px solid var(--color-azure); border-bottom: 2.5px solid var(--color-azure); transform: rotate(-45deg);
  }

  /* ---------- results ---------- */
  .gallery { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 20px; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .gallery .g-big img { aspect-ratio: auto; height: 100%; max-height: 100%; }
  .g-big { display: flex; flex-direction: column; }
  .g-big img { flex: 1; min-height: 0; }
  .gallery figcaption { margin-top: 10px; font-size: 14px; color: var(--color-slate); }

  /* ---------- included ---------- */
  .inc-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .inc-cols h3 { padding-bottom: 12px; border-bottom: 2px solid var(--color-ink); }
  .mid-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 48px; font-size: 15px; color: var(--color-slate); }
  .mid-cta a:not(.btn) { color: var(--color-ink); font-weight: 700; }

  /* ---------- reviews ---------- */
  .rev-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px; margin-bottom: 48px; }
  .rev-head h2 { max-width: 12em; }
  .rev-score { display: grid; grid-template-columns: auto auto; column-gap: 14px; align-items: center; }
  .score { grid-row: span 2; font-stretch: 125%; font-weight: 850; font-size: 64px; letter-spacing: -0.05em; line-height: 0.9; color: var(--color-azure); }
  .rev-count { font-size: 14px; color: var(--color-slate); }
  .rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .q { margin: 0; border-top: 2px solid var(--color-ink); padding-top: 22px; }
  .q blockquote { margin: 0 0 12px; }
  .q p { margin: 0; font-weight: 600; font-size: 18px; line-height: 1.45; }
  .q figcaption { font-size: 14.5px; color: var(--color-slate); }
  .q strong { color: var(--color-ink); }

  /* ---------- owner ---------- */
  .owner { display: grid; grid-template-columns: 160px 1fr; gap: 36px; align-items: center; max-width: 880px; }
  .owner img { width: 160px; height: 160px; object-fit: cover; border-radius: 50%; }
  .owner p { margin: 12px 0 0; font-size: 17px; line-height: 1.65; color: var(--color-slate); max-width: 36em; }

  .steps-title { margin-bottom: 48px; }
  .faq-title { margin-bottom: 36px; }

  /* ---------- close ---------- */
  .lp-close { padding: 88px 0 32px; }
  .close-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: end; }
  .close-grid .lede { margin-top: 18px; }
  .close-grid .btn-row { justify-content: flex-end; }
  .lp-legal { margin-top: 72px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,0.14); font-size: 13.5px; color: rgba(255,255,255,0.55); }

  .lp-bar { display: none; }

  @media (max-width: 960px) {
    .lp-hero { padding: 20px 0 0; background: #fff; }
    .lp-grid { grid-template-columns: 1fr; gap: 20px; }
    .lp-copy { position: static; padding-top: 0; }
    .rating { margin-bottom: 12px; font-size: 14px; }
    .lp-copy h1 { font-size: clamp(32px, 8.6vw, 44px); }
    .lp-copy .lede { display: none; }
    .lp-facts { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--color-line); }
    .lp-facts li { flex-direction: column; gap: 2px; border-bottom: 0; padding: 12px 0; }
    .lp-facts li + li { padding-left: 16px; border-left: 1px solid var(--color-line); }
    .lp-facts span { text-align: left; font-size: 13.5px; }
    .lp-facts strong { font-size: 18px; }
    .hide-sm { display: none !important; }
    .hero-quote { display: none; }
    .lp-cal { margin: 0 -20px; box-shadow: none; border-bottom: 1px solid var(--color-line); }
    .lp-cal-head { padding: 18px 20px 4px; }
    .assure { padding: 14px 20px 18px; flex-direction: column; gap: 8px; }
    .gallery { grid-template-columns: 1fr 1fr; }
    .g-big { grid-column: 1 / -1; }
    .gallery .g-big img { height: auto; }
    .rev-grid, .close-grid { grid-template-columns: 1fr; gap: 32px; }
    .close-grid .btn-row { justify-content: flex-start; }
    .lp-close { padding-bottom: 104px; }
    .lp-bar {
      display: grid; grid-template-columns: 1.6fr 1fr; gap: 10px;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
