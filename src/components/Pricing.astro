---
import pricingData from '../data/pricing.json';
import SectionHead from './SectionHead.astro';

function splitPrice(price: string) {
  const parts = price.split('.');
  return { whole: parts[0], cents: parts[1] || null };
}
---

<section class="pricing" id="pricing">
  <div class="h-container">
    <SectionHead
      eyebrow="Transparent pricing"
      headlineHtml="No surprises. <em>No haggling.</em>"
      subhead="Different locations, different services, different prices. Here's exactly what each tier includes."
    />

    <div class="pricing-tabs" role="tablist">
      <button class="pricing-tab active" data-tab="handwash" type="button" role="tab" aria-selected="true">
        Hand wash · North Palm Beach
      </button>
      <button class="pricing-tab" data-tab="machine" type="button" role="tab" aria-selected="false">
        Machine wash · Jupiter
      </button>
    </div>

    {(['handwash', 'machine'] as const).map((menu, idx) => {
      const data = pricingData[menu];
      const gridClass = menu === 'machine' ? 'price-grid machine' : 'price-grid';
      return (
        <div class={`pricing-panel ${idx === 0 ? 'active' : ''}`} id={`panel-${menu}`} role="tabpanel">
          <div class="pricing-intro">
            <h3>{data.title}</h3>
            <p>{data.subtitle}</p>
          </div>
          <div class={gridClass}>
            {data.tiers.map((tier: any) => {
              const { whole, cents } = splitPrice(tier.price);
              return (
                <div class={`price-card ${tier.featured ? 'featured' : ''}`}>
                  <div class="price-tier">{tier.name}</div>
                  <div class="price-amount">
                    <span class="currency">$</span>{whole}{cents && <span class="cents">.{cents}</span>}
                  </div>
                  <div class="price-period">
                    {tier.period}
                    {tier.memberPrice && <strong>or {tier.memberPrice}</strong>}
                  </div>
                  <ul class="price-includes">
                    {tier.includes.map((item: string) => <li>{item}</li>)}
                  </ul>
                </div>
              );
            })}
          </div>
          <p class="pricing-note">{data.note}</p>
        </div>
      );
    })}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.pricing-tab');
  const panels = document.querySelectorAll('.pricing-panel');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      const target = document.getElementById(`panel-${(tab as HTMLElement).dataset.tab}`);
      if (target) target.classList.add('active');
    });
  });
</script>

<style>
  .pricing {
    padding: 120px 0;
    background: var(--color-cream-warm);
  }
  .pricing-tabs {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 56px;
    border-bottom: 1px solid var(--color-gray-line);
  }
  .pricing-tab {
    padding: 16px 36px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gray-warm);
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    background: none;
    font-family: var(--font-body);
  }
  .pricing-tab.active {
    color: var(--color-navy);
    border-bottom-color: var(--color-clay);
  }
  .pricing-tab:hover:not(.active) { color: var(--color-charcoal); }
  .pricing-panel { display: none; }
  .pricing-panel.active { display: block; }

  .pricing-intro {
    text-align: center;
    margin-bottom: 48px;
  }
  .pricing-intro h3 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    color: var(--color-navy);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .pricing-intro p {
    font-size: 15px;
    color: var(--color-gray-warm);
    max-width: 540px;
    margin: 0 auto;
  }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .price-grid.machine {
    grid-template-columns: repeat(4, 1fr);
    max-width: 920px;
  }
  .price-card {
    background: var(--color-cream);
    border: 1px solid var(--color-gray-line);
    padding: 32px 24px;
    text-align: center;
    position: relative;
    transition: all 0.3s ease;
  }
  .price-card.featured {
    border: 2px solid var(--color-gold);
    transform: scale(1.02);
  }
  .price-card.featured::before {
    content: 'Best shine';
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-gold);
    color: var(--color-navy);
    padding: 4px 14px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .price-tier {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray-warm);
    font-weight: 600;
    margin-bottom: 14px;
  }
  .price-amount {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 500;
    color: var(--color-navy);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .price-amount .currency { font-size: 22px; vertical-align: super; }
  .price-amount .cents { font-size: 22px; }
  .price-period {
    font-size: 12px;
    color: var(--color-gray-warm);
    margin-top: 6px;
    margin-bottom: 24px;
  }
  .price-period strong {
    display: block;
    color: var(--color-clay);
    font-weight: 500;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .price-includes {
    font-size: 13px;
    text-align: left;
    color: var(--color-charcoal-soft);
    line-height: 1.55;
    list-style: none;
    padding: 20px 0 0;
    margin: 0;
    border-top: 1px solid var(--color-gray-line);
  }
  .price-includes li {
    padding: 5px 0 5px 18px;
    position: relative;
  }
  .price-includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12px;
    width: 8px;
    height: 1px;
    background: var(--color-gold);
  }
  .pricing-note {
    text-align: center;
    margin-top: 40px;
    font-size: 13px;
    color: var(--color-gray-warm);
    font-style: italic;
  }
  @media (max-width: 1024px) {
    .price-grid,
    .price-grid.machine { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .pricing { padding: 72px 0; }
    .price-grid,
    .price-grid.machine { grid-template-columns: 1fr; }
    .pricing-tabs { flex-wrap: wrap; }
    .pricing-tab { padding: 14px 20px; font-size: 12px; }
  }
</style>
