---
export interface Props {
  eyebrow?: string;
  headlineHtml: string;
  lead?: string;
  metaLeft?: string;
  metaRight?: string;
}
const { eyebrow, headlineHtml, lead, metaLeft, metaRight } = Astro.props;
---

<section class="page-hero">
  <div class="container-wide">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h1 class="display-1" set:html={headlineHtml} />
    {lead && <p class="lead">{lead}</p>}
    {(metaLeft || metaRight) && (
      <div class="hero-meta">
        {metaLeft && <span>{metaLeft}</span>}
        {metaLeft && metaRight && <span class="meta-sep">·</span>}
        {metaRight && <span>{metaRight}</span>}
      </div>
    )}
  </div>
  <hr class="rule-gold" />
</section>

<style>
  .page-hero {
    padding: 80px 0 0;
  }
  .page-hero .eyebrow {
    margin-bottom: 32px;
  }
  .page-hero h1 {
    max-width: 1000px;
    margin: 0;
  }
  .lead {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.4;
    color: var(--color-charcoal-soft);
    max-width: 720px;
    margin: 32px 0 0;
    font-weight: 400;
  }
  .hero-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 40px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gray-warm);
  }
  .meta-sep {
    color: var(--color-gold);
  }
  .rule-gold {
    margin-top: 64px;
  }
  @media (max-width: 640px) {
    .page-hero { padding: 56px 0 0; }
    .rule-gold { margin-top: 40px; }
  }
</style>
