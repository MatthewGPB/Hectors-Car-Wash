---
export interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  facts?: string[];
}
const { kicker, title, lead, facts = [] } = Astro.props;
---

<section class="page-hero">
  <div class="container-wide">
    {kicker && <span class="kicker">{kicker}</span>}
    <h1 class="h-xl">{title}</h1>
    {lead && <p class="lede">{lead}</p>}
    {facts.length > 0 && (
      <ul class="facts">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    )}
    <slot />
  </div>
</section>

<style>
  .page-hero { padding: 88px 0 64px; }
  .page-hero h1 { max-width: 14em; }
  .lede { margin-top: 28px; }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
  }
  .facts li {
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--color-mist);
    font-size: 15px;
    font-weight: 600;
  }
  @media (max-width: 640px) { .page-hero { padding: 56px 0 44px; } }
</style>
