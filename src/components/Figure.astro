---
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  ratio?: string;
  caption?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, width, height, ratio = '3/2', caption, class: className = '', eager = false } = Astro.props;
---

<figure class={`fig ${className}`}>
  <div class="fig-frame" style={`aspect-ratio: ${ratio};`}>
    <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 0; }
  .fig-frame { background: var(--color-mist); overflow: hidden; }
  .fig-frame img { width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: 12px; font-size: 14px; color: var(--color-slate); }
</style>
