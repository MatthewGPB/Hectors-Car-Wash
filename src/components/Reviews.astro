---
import reviewsData from '../data/reviews.json';
import siteData from '../data/site.json';

const featured = reviewsData.reviews.filter((r) => r.featured).slice(0, 3);
---

<section class="reviews" id="reviews">
  <div class="h-container">
    <div class="reviews-header">
      <h2 class="reviews-h2 h-display">
        What Palm Beach<br />
        <em>says about us.</em>
      </h2>
      <div class="reviews-rating">
        <div class="stars">★★★★★</div>
        <div class="rating-text">
          <div class="rating-num">{siteData.brand.rating} / 5</div>
          <div class="rating-label">{siteData.brand.reviewCount}+ Google reviews</div>
        </div>
      </div>
    </div>

    <div class="review-grid">
      {featured.map((review) => (
        <article class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"{review.quote}"</p>
          <div class="review-author">{review.author}</div>
          <div class="review-meta">{review.source}</div>
        </article>
      ))}
    </div>

    <div class="reviews-cta">
      <a href={siteData.primary.googleReviewsUrl} class="h-btn h-btn-outline" target="_blank" rel="noopener">
        Read all reviews on Google →
      </a>
    </div>
  </div>
</section>

<style>
  .reviews {
    padding: 120px 0;
    background: var(--color-cream);
  }
  .reviews-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 72px;
  }
  .reviews-h2 {
    font-size: clamp(36px, 4.5vw, 56px);
    margin: 0;
  }
  .reviews-rating {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }
  .stars {
    color: var(--color-gold);
    font-size: 20px;
    letter-spacing: 0.1em;
  }
  .rating-text { text-align: right; }
  .rating-num {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 500;
    color: var(--color-navy);
    line-height: 1;
  }
  .rating-label {
    font-size: 12px;
    color: var(--color-gray-warm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 4px;
  }
  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .review-card {
    padding: 36px 32px;
    background: var(--color-cream-warm);
    border-left: 2px solid var(--color-gold);
  }
  .review-stars {
    color: var(--color-gold);
    letter-spacing: 0.08em;
    font-size: 14px;
    margin-bottom: 18px;
  }
  .review-text {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-charcoal);
    margin: 0 0 24px;
    font-style: italic;
  }
  .review-author {
    font-size: 13px;
    color: var(--color-navy);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .review-meta {
    font-size: 11px;
    color: var(--color-gray-warm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 4px;
  }
  .reviews-cta {
    text-align: center;
    margin-top: 56px;
  }
  @media (max-width: 1024px) {
    .reviews-header { grid-template-columns: 1fr; gap: 32px; }
    .reviews-rating { justify-content: flex-start; }
    .review-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .reviews { padding: 72px 0; }
  }
</style>
