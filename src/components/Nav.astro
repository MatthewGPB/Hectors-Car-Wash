---
import siteData from '../data/site.json';
---

<header class="nav-wrap">
  <div class="container-wide">
    <nav class="nav">
      <a href="/" class="logo" aria-label="Hector's Car Wash">
        <img src="/images/hectors-car-wash-logo.png" alt="Hector's Car Wash" class="logo-img" />
      </a>

      <!-- Desktop links -->
      <ul class="nav-links">
        <li><a href="/locations/north-palm-beach">North Palm Beach</a></li>
        <li><a href="/locations/jupiter">Jupiter</a></li>
        <li class="sep" aria-hidden="true">·</li>
        <li><a href="/services/car-detailing">Detailing</a></li>
        <li><a href="/services/ceramic-coating">Ceramic</a></li>
        <li class="sep" aria-hidden="true">·</li>
        <li><a href="/about">About</a></li>
      </ul>

      <a href={siteData.primary.calendly} class="nav-cta desktop-cta">Book</a>

      <!-- Mobile hamburger button -->
      <button
        class="nav-toggle"
        id="navToggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile menu panel -->
  <div class="mobile-menu" id="mobileMenu" hidden>
    <ul class="mobile-links">
      <li class="mobile-group-label">Locations</li>
      <li><a href="/locations/north-palm-beach">North Palm Beach</a></li>
      <li><a href="/locations/jupiter">Jupiter</a></li>
      <li class="mobile-group-label">Services</li>
      <li><a href="/services/car-detailing">Car Detailing</a></li>
      <li><a href="/services/ceramic-coating">Ceramic Coating</a></li>
      <li class="mobile-group-label">More</li>
      <li><a href="/about">About</a></li>
      <li><a href="/pages/review">Reviews</a></li>
    </ul>
    <a href={siteData.primary.calendly} class="nav-cta mobile-cta">Book an appointment</a>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('navToggle');
    var menu = document.getElementById('mobileMenu');
    if (!toggle || !menu) return;

    function openMenu() {
      menu.hidden = false;
      requestAnimationFrame(function () { menu.classList.add('open'); });
      toggle.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menu.classList.remove('open');
      toggle.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      setTimeout(function () {
        if (!menu.classList.contains('open')) menu.hidden = true;
      }, 300);
    }

    toggle.addEventListener('click', function () {
      if (toggle.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.classList.contains('is-open')) {
        closeMenu();
      }
    });
  })();
</script>

<style>
  .nav-wrap {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-gray-line);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    gap: 32px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }
  .logo-img {
    height: 48px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .nav-links a {
    color: var(--color-charcoal-soft);
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .nav-links a:hover { color: var(--color-clay); }
  .nav-links .sep {
    color: var(--color-gray-line);
    font-size: 14px;
  }
  .nav-cta {
    background: var(--color-navy);
    color: var(--color-cream);
    padding: 11px 22px;
    border-radius: 1px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s ease;
    text-decoration: none;
  }
  .nav-cta:hover { background: var(--color-clay); }

  /* ============ HAMBURGER BUTTON ============ */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
  }
  .nav-toggle .bar {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--color-navy);
    margin: 0 auto;
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  .nav-toggle.is-open .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle.is-open .bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle.is-open .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ============ MOBILE MENU PANEL ============ */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-cream);
    z-index: 99;
    padding: 104px 32px 48px;
    overflow-y: auto;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
  }
  .mobile-links {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
  }
  .mobile-group-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 28px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-gray-line);
  }
  .mobile-group-label:first-child {
    margin-top: 0;
  }
  .mobile-links li a {
    display: block;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    color: var(--color-navy);
    text-decoration: none;
    padding: 10px 0;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }
  .mobile-links li a:hover,
  .mobile-links li a:active {
    color: var(--color-clay);
  }
  .mobile-cta {
    display: block;
    text-align: center;
    padding: 18px;
    font-size: 13px;
  }

  /* ============ RESPONSIVE BREAKPOINTS ============ */
  @media (max-width: 1024px) {
    .nav-links { display: none; }
    .desktop-cta { display: none; }
    .nav-toggle { display: flex; }
    .mobile-menu { display: block; }
  }
  @media (max-width: 640px) {
    .logo-img { height: 40px; }
    .mobile-menu { padding: 96px 24px 40px; }
    .mobile-links li a { font-size: 23px; }
  }
</style>
