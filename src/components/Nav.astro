---
import siteData from '../data/site.json';
import locationsData from '../data/locations.json';
const shop = locationsData.locations[0];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/#prices', label: 'Prices' },
  { href: '/services/car-detailing', label: 'Detailing' },
  { href: '/services/ceramic-coating', label: 'Ceramic coating' },
  { href: '/about', label: 'About Hector' },
  { href: '/pages/review', label: 'Reviews' },
];
---

<header class="nav-wrap">
  <div class="container-wide">
    <nav class="nav" aria-label="Main">
      <a href="/" class="brand" aria-label="Hector's Car Wash, home">
        <img src="/images/hectors-car-wash-logo.png" alt="" class="brand-badge" width="44" height="44" />
        <span class="brand-text">
          <span class="brand-name" data-no-i18n>Hector's</span>
          <span class="brand-sub">Hand car wash</span>
        </span>
      </a>

      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>

      <div class="nav-right">
        <div class="lang-toggle" role="group" aria-label="Language" data-no-i18n>
          <button type="button" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
          <button type="button" data-lang="es" aria-pressed="false" aria-label="Español">ES</button>
        </div>
        <a href={`tel:${shop.phoneE164}`} class="nav-call">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
          <span class="nav-call-num" data-no-i18n>{shop.phone}</span>
          <span class="sr-only">Call Hector's</span>
        </a>
        <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
          <span class="bar"></span><span class="bar"></span>
        </button>
      </div>
    </nav>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    <div class="mobile-sheet">
      <ul class="mobile-links">
        <li><a href="/">Home</a></li>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <div class="mobile-actions">
        <a href={shop.mapsUrl} target="_blank" rel="noopener" class="btn btn-azure" data-directions-label={shop.directionsLabel}>Get directions</a>
        <a href={siteData.primary.calendly} class="btn btn-line">Book detailing or ceramic</a>
      </div>
      <p class="mobile-hours">
        <span data-no-i18n>{shop.address.street}, {shop.address.city}</span><br />
        Mon–Sat 8:00 AM – 5:30 PM, Sun 9:00 AM – 4:00 PM
      </p>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('navToggle');
    var menu = document.getElementById('mobileMenu');
    if (!toggle || !menu) return;
    function openMenu() {
      menu.hidden = false;
      requestAnimationFrame(function () { menu.classList.add('open'); });
      toggle.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    }
    function closeMenu() {
      menu.classList.remove('open');
      toggle.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      setTimeout(function () { if (!menu.classList.contains('open')) menu.hidden = true; }, 250);
    }
    toggle.addEventListener('click', function () {
      toggle.classList.contains('is-open') ? closeMenu() : openMenu();
    });
    menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', closeMenu); });
    menu.addEventListener('click', function (e) { if (e.target === menu) closeMenu(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.classList.contains('is-open')) closeMenu();
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 1080 && toggle.classList.contains('is-open')) closeMenu();
    });
  })();
</script>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav {
    position: relative;
    z-index: 110;
    display: flex;
    align-items: center;
    gap: 28px;
    height: 76px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .brand-badge { width: 44px; height: 44px; }
  .brand-text { display: flex; flex-direction: column; line-height: 1; }
  .brand-name {
    font-stretch: 125%;
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.02em;
  }
  .brand-sub {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-slate);
    margin-top: 4px;
  }
  .nav-links {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
  }
  .nav-links a {
    font-size: 15px;
    font-weight: 550;
    color: var(--color-ink);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] { border-bottom-color: var(--color-azure); }
  .nav-right { display: flex; align-items: center; gap: 14px; }
  .nav-call {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--color-azure);
    color: var(--color-ink);
    font-stretch: 110%;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .nav-call:hover { background: #4FB0E3; }

  .lang-toggle {
    display: inline-flex;
    border: 1.5px solid var(--color-line);
    border-radius: 999px;
    padding: 2px;
  }
  .lang-toggle button {
    appearance: none;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 999px;
    color: var(--color-slate);
    cursor: pointer;
  }
  .lang-toggle button[aria-pressed='true'] { background: var(--color-ink); color: #fff; }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }
  .nav-toggle .bar {
    position: absolute;
    left: 10px;
    width: 24px;
    height: 2.5px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s ease, top 0.2s ease;
  }
  .nav-toggle .bar:nth-child(1) { top: 17px; }
  .nav-toggle .bar:nth-child(2) { top: 25px; }
  .nav-toggle.is-open .bar:nth-child(1) { top: 21px; transform: rotate(45deg); }
  .nav-toggle.is-open .bar:nth-child(2) { top: 21px; transform: rotate(-45deg); }

  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99;
    background: rgba(11, 22, 29, 0.4);
    opacity: 0;
    transition: opacity 0.2s ease;
    overflow-y: auto;
  }
  .mobile-menu.open { opacity: 1; }
  .mobile-sheet {
    background: #fff;
    padding: 96px 24px 32px;
    border-bottom: 12px solid var(--color-azure);
  }
  .mobile-links { list-style: none; margin: 0 0 28px; padding: 0; }
  .mobile-links a {
    display: block;
    font-stretch: 125%;
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
    padding: 9px 0;
  }
  .mobile-actions { display: grid; gap: 10px; }
  .mobile-hours { margin: 22px 0 0; font-size: 14px; color: var(--color-slate); line-height: 1.6; }

  @media (max-width: 1080px) {
    .nav-links { display: none; }
    .nav-right { margin-left: auto; }
    .nav-toggle { display: block; }
    .mobile-menu { display: block; }
  }
  @media (max-width: 560px) {
    .nav { gap: 12px; height: 68px; }
    .brand-badge { width: 38px; height: 38px; }
    .brand-name { font-size: 18px; }
    .brand-sub { display: none; }
    .nav-right { gap: 8px; }
    .nav-call { width: 44px; padding: 0; justify-content: center; }
    .nav-call-num { display: none; }
  }
</style>
