---
import siteData from '../data/site.json';
---

<header class="nav-wrap">
  <div class="container-wide">
    <nav class="nav">
      <a href="/" class="logo" aria-label="Hector's Car Wash">
        <img src="/images/hectors-car-wash-logo.png" alt="Hector's Car Wash" class="logo-img" />
      </a>
      <ul class="nav-links">
        <li><a href="/locations/north-palm-beach">North Palm Beach</a></li>
        <li><a href="/locations/jupiter">Jupiter</a></li>
        <li><a href="/locations/riviera-beach">Riviera Beach</a></li>
        <li class="sep" aria-hidden="true">·</li>
        <li><a href="/services/car-detailing">Detailing</a></li>
        <li><a href="/services/ceramic-coating">Ceramic</a></li>
        <li class="sep" aria-hidden="true">·</li>
        <li><a href="/about">About</a></li>
      </ul>
      <a href={siteData.primary.calendly} class="nav-cta">Book</a>
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-gray-line);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    gap: 32px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }
  .logo-img {
    height: 48px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .nav-links a {
    color: var(--color-charcoal-soft);
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .nav-links a:hover { color: var(--color-clay); }
  .nav-links .sep {
    color: var(--color-gray-line);
    font-size: 14px;
  }
  .nav-cta {
    background: var(--color-navy);
    color: var(--color-cream);
    padding: 11px 22px;
    border-radius: 1px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s ease;
    text-decoration: none;
  }
  .nav-cta:hover { background: var(--color-clay); }

  @media (max-width: 1024px) {
    .nav-links { display: none; }
  }
  @media (max-width: 640px) {
    .logo-img { height: 40px; }
  }
</style>
