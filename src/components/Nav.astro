---
import siteData from '../data/site.json';
---

<header class="nav-wrap">
  <div class="h-container">
    <nav class="nav">
      <a href="/" class="logo" aria-label={`${siteData.brand.name} home`}>
        Hector's<span>·</span>Car Wash
      </a>
      <ul class="nav-links">
        <li><a href="/#locations">Locations</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="/#reviews">Reviews</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <a href={siteData.primary.calendly} class="nav-cta">Book detailing</a>
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-gray-line);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .logo {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
  }
  .logo span {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 500;
  }
  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .nav-links a {
    color: var(--color-charcoal-soft);
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .nav-links a:hover { color: var(--color-navy); }
  .nav-cta {
    background: var(--color-navy);
    color: var(--color-cream);
    padding: 11px 22px;
    border-radius: 2px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.2s ease;
    text-decoration: none;
  }
  .nav-cta:hover { background: var(--color-clay); }

  @media (max-width: 768px) {
    .nav-links { display: none; }
  }
</style>
