---
import siteData from '../data/site.json';
import locationsData from '../data/locations.json';
const shop = locationsData.locations[0];
const year = new Date().getFullYear();
---

<footer class="footer on-ink">
  <hr class="stripe" />
  <div class="container-wide">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="f-logo" aria-label="Hector's Car Wash, home">
          <img src="/images/hectors-car-wash-logo.png" alt="" width="64" height="64" />
        </a>
        <p class="f-tag">{siteData.brand.tagline}</p>
      </div>

      <div class="footer-col">
        <h2 class="f-head">Visit</h2>
        <p data-no-i18n>{shop.address.street}<br />{shop.address.city}, {shop.address.state} {shop.address.zip}</p>
        <a href={shop.mapsUrl} target="_blank" rel="noopener" class="text-link" data-directions-label={shop.directionsLabel}>Get directions</a>
      </div>

      <div class="footer-col">
        <h2 class="f-head">Hours</h2>
        <p>Monday to Saturday<br /><span data-no-i18n>{shop.hours.monSat}</span></p>
        <p>Sunday<br /><span data-no-i18n>{shop.hours.sunday}</span></p>
      </div>

      <div class="footer-col">
        <h2 class="f-head">Call or book</h2>
        <p><a href={`tel:${shop.phoneE164}`} class="f-phone" data-no-i18n>{shop.phone}</a></p>
        <ul class="f-links">
          <li><a href="/services/car-detailing">Car detailing</a></li>
          <li><a href="/services/ceramic-coating">Ceramic coating</a></li>
          <li><a href="/about">About Hector</a></li>
          <li><a href="/pages/review">Reviews</a></li>
        </ul>
      </div>
    </div>

    <p class="f-sister">
      Looking for the express wash and memberships in Jupiter? That's our sister wash, <a href="https://jupitercarwash.com" rel="noopener" class="text-link" data-no-i18n>Jupiter Car Wash</a>.
    </p>

    <div class="footer-bottom">
      <div>© {year} {siteData.brand.name}. All rights reserved.</div>
      <div class="social" data-no-i18n>
        <a href={siteData.social.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={siteData.social.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={siteData.social.tiktok} target="_blank" rel="noopener">TikTok</a>
      </div>
      <div class="credit">Website built by <a href="https://growpalmbeach.com" target="_blank" rel="noopener" data-no-i18n>Grow Palm Beach</a></div>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 0 0 36px; }
  .footer .stripe { margin-bottom: 80px; }
  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 56px;
  }
  .f-logo img { width: 64px; height: 64px; }
  .f-tag {
    font-stretch: 118%;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 15em;
    margin: 22px 0 0;
  }
  .f-head {
    font-size: 14px;
    font-weight: 650;
    font-stretch: 112%;
    color: var(--color-azure-light);
    margin: 0 0 14px;
  }
  .footer-col p { margin: 0 0 14px; font-size: 15.5px; line-height: 1.55; color: rgba(255,255,255,0.86); }
  .f-phone {
    font-stretch: 118%;
    font-weight: 800;
    font-size: 22px;
    color: #fff;
    text-decoration: none;
  }
  .f-links { list-style: none; margin: 0; padding: 0; }
  .f-links a {
    display: inline-block;
    padding: 3px 0;
    font-size: 15.5px;
    color: rgba(255,255,255,0.86);
    text-decoration: none;
  }
  .f-links a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .f-sister {
    margin: 0;
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,0.14);
    font-size: 15px;
    color: rgba(255,255,255,0.72);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.14);
    font-size: 13.5px;
    color: rgba(255,255,255,0.55);
  }
  .social { display: flex; gap: 22px; }
  .social a, .credit a { color: rgba(255,255,255,0.8); text-decoration: none; }
  .social a:hover, .credit a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .footer .stripe { margin-bottom: 56px; }
    .footer-top { grid-template-columns: 1fr; gap: 36px; }
    .footer-bottom { flex-direction: column; }
  }
</style>
