---
import siteData from '../data/site.json';
import locationsData from '../data/locations.json';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="h-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">Hector's<span>·</span>Car Wash</a>
        <p>
          Family-owned hand car wash, machine wash, detailing & ceramic coating. Serving Palm Beach County for almost 30 years.
        </p>
      </div>
      <div>
        <h4>Locations</h4>
        <ul>
          {locationsData.locations.map((loc) => (
            <li><a href={`/locations/${loc.slug}`}>{loc.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="/#services">Hand car wash</a></li>
          <li><a href="/#services">Express wash</a></li>
          <li><a href={siteData.primary.calendly}>Car detailing</a></li>
          <li><a href={siteData.primary.calendly}>Ceramic coating</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Hector</a></li>
          <li><a href="/#reviews">Reviews</a></li>
          <li><a href="/#locations">Contact</a></li>
          <li><a href={siteData.primary.calendly}>Book online</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© {year} {siteData.brand.name}. All rights reserved.</div>
      <div class="footer-social">
        <a href={siteData.social.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={siteData.social.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={siteData.social.tiktok} target="_blank" rel="noopener">TikTok</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-deep);
    color: rgba(250, 247, 242, 0.7);
    padding: 72px 0 32px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-brand .logo {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    color: var(--color-cream);
    text-decoration: none;
    margin-bottom: 16px;
    display: block;
  }
  .footer-brand .logo span {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 500;
  }
  .footer-brand p {
    font-size: 14px;
    line-height: 1.6;
    max-width: 280px;
    margin: 0;
  }
  .footer h4 {
    color: var(--color-cream);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 20px;
    font-family: var(--font-body);
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer ul li { margin-bottom: 10px; font-size: 14px; }
  .footer ul a {
    color: rgba(250, 247, 242, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer ul a:hover { color: var(--color-gold); }
  .footer-bottom {
    border-top: 1px solid rgba(250, 247, 242, 0.1);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: rgba(250, 247, 242, 0.5);
  }
  .footer-social {
    display: flex;
    gap: 20px;
  }
  .footer-social a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-social a:hover { color: var(--color-gold); }

  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; gap: 16px; }
  }
</style>
