---
// Live "open now" line, computed in the visitor's browser against shop time
// (America/New_York). Falls back to the posted hours if JS is off.
// Mon–Sat 8:00–17:30, Sun 9:00–16:00 — keep in sync with locations.json.
export interface Props { class?: string }
const { class: className = '' } = Astro.props;
---

<p class={`open-status ${className}`} data-open-status data-no-i18n>
  <span class="dot" aria-hidden="true"></span>
  <span class="open-text">Mon–Sat 8:00 AM – 5:30 PM, Sun 9:00 AM – 4:00 PM</span>
</p>

<script is:inline>
  (function () {
    var HOURS = { 0: [9 * 60, 16 * 60], 1: [480, 1050], 2: [480, 1050], 3: [480, 1050], 4: [480, 1050], 5: [480, 1050], 6: [480, 1050] };
    function fmt(m, es) {
      var h = Math.floor(m / 60), mm = m % 60;
      var ap = h >= 12 ? 'PM' : 'AM';
      var h12 = h % 12 || 12;
      return h12 + (mm ? ':' + String(mm).padStart(2, '0') : '') + ' ' + ap;
    }
    function now() {
      var parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York', weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23'
      }).formatToParts(new Date());
      var o = {};
      parts.forEach(function (p) { o[p.type] = p.value; });
      var day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(o.weekday);
      return { day: day, min: parseInt(o.hour, 10) * 60 + parseInt(o.minute, 10) };
    }
    function render() {
      var es = document.documentElement.lang === 'es';
      var n = now(), today = HOURS[n.day], txt, open = false;
      if (n.min >= today[0] && n.min < today[1]) {
        open = true;
        txt = es ? 'Abierto ahora, hasta las ' + fmt(today[1]) : 'Open now, until ' + fmt(today[1]);
      } else if (n.min < today[0]) {
        txt = es ? 'Cerrado ahora. Abre hoy a las ' + fmt(today[0]) : 'Closed now. Opens today at ' + fmt(today[0]);
      } else {
        var t = HOURS[(n.day + 1) % 7];
        txt = es ? 'Cerrado ahora. Abre mañana a las ' + fmt(t[0]) : 'Closed now. Opens tomorrow at ' + fmt(t[0]);
      }
      document.querySelectorAll('[data-open-status]').forEach(function (el) {
        el.classList.toggle('is-open', open);
        el.querySelector('.open-text').textContent = txt;
      });
    }
    render();
    new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
    setInterval(render, 60000);
  })();
</script>

<style>
  .open-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: inherit;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-slate);
    flex-shrink: 0;
  }
  .open-status.is-open .dot {
    background: var(--color-curb);
    box-shadow: 0 0 0 4px rgba(245, 197, 24, 0.28);
  }
</style>
