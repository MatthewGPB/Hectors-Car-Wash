---
import siteData from '../data/site.json';
const { announcement } = siteData;
---

{announcement.show && (
  <div class="announcement">
    <div class="container-wide">
      <a href={announcement.link}>
        <strong>{announcement.badge}</strong>
        
        {announcement.message}
      </a>
    </div>
  </div>
)}

<style>
  .announcement { background: var(--color-azure); color: var(--color-ink); padding: 10px 0; font-size: 14px; text-align: center; }
  .announcement a { color: inherit; text-decoration: none; }
  .announcement strong { font-weight: 800; margin-right: 8px; }
</style>
