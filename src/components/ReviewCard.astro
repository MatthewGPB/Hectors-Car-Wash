---
export interface Props {
  quote: string;
  author: string;
  source: string;
  variant?: 'default' | 'large';
}
const { quote, author, source, variant = 'default' } = Astro.props;
---

<figure class={`review ${variant}`}>
  <div class="stars" role="img" aria-label="5 out of 5 stars">
    {[1, 2, 3, 4, 5].map(() => (
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M10 1.5l2.6 5.5 6 .7-4.5 4.1 1.2 5.9L10 14.8l-5.3 2.9 1.2-5.9L1.4 7.7l6-.7z"/></svg>
    ))}
  </div>
  <blockquote data-no-i18n><p>“{quote}”</p></blockquote>
  <figcaption>
    <span class="who" data-no-i18n>{author}</span>
    <span class="src" data-no-i18n>{source}</span>
  </figcaption>
</figure>

<style>
  .review { margin: 0; display: flex; flex-direction: column; }
  .stars { display: flex; gap: 2px; color: var(--color-azure); margin-bottom: 16px; }
  blockquote { margin: 0 0 20px; }
  blockquote p {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--color-ink);
  }
  .large blockquote p { font-size: clamp(20px, 2vw, 24px); line-height: 1.45; }
  figcaption { margin-top: auto; display: flex; flex-direction: column; gap: 2px; }
  .who { font-weight: 700; font-size: 15px; }
  .src { font-size: 13.5px; color: var(--color-slate); }
</style>
