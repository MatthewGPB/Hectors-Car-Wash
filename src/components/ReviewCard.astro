---
export interface Props {
  quote: string;
  author: string;
  source: string;
  variant?: 'default' | 'large';
}
const { quote, author, source, variant = 'default' } = Astro.props;
---

<article class={`review-card ${variant}`}>
  <div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div>
  <p class="review-text">"{quote}"</p>
  <div class="review-author">{author}</div>
  <div class="review-meta">{source}</div>
</article>

<style>
  .review-card {
    padding: 36px 32px;
    background: var(--color-cream-warm);
    border-left: 2px solid var(--color-gold);
  }
  .review-card.large {
    padding: 56px 48px;
    background: var(--color-cream);
    border: 1px solid var(--color-gray-line);
    border-left: 3px solid var(--color-gold);
  }
  .review-stars {
    color: var(--color-gold);
    letter-spacing: 0.1em;
    font-size: 14px;
    margin-bottom: 18px;
  }
  .review-card.large .review-stars { font-size: 16px; }
  .review-text {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-charcoal);
    margin: 0 0 24px;
    font-style: italic;
    font-size: 17px;
  }
  .review-card.large .review-text {
    font-size: 22px;
    line-height: 1.5;
    margin-bottom: 32px;
  }
  .review-author {
    font-size: 13px;
    color: var(--color-navy);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .review-meta {
    font-size: 11px;
    color: var(--color-gray-warm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 4px;
  }
</style>
